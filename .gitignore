.claude/settings.local.json
.claude/workstreams.json

# ─── Legacy Webflow Artifacts (removed 2026-03-22) ───────────────
# Webflow is a secondary platform. Token source is Figma → Style Dictionary.
updates/
archive/
*.webflow/
json/
cms/
markdown/
images/
test/

# ─── Root css/ and js/ directories ───────────────────────────────
# BDS animation library lives here (used by mockups and Astro builds).
# Legacy Webflow artifacts also exist here — ignore those specifically.
css/*.webflow.css
css/brik-bds.css
css/filtering.css
css/normalize.css
css/webflow.css
css/wf-*.css
js/webflow.js
js/cms-content-system.js
js/count-contacts.js
js/footer.js
js/industry-data.js
js/list-notion-databases.js
js/publish-webflow*.js
js/test-*.js
js/theme-switcher.js

# ─── Webflow HTML pages (site exports) ───────────────────────────
# Only .html inside .storybook/ should be tracked
/*.html
detail_*.html
static-template-*.html
web-modules*.html
healthcare-*.html
image-license-info.html
modules.html

# ─── Stale one-off files ─────────────────────────────────────────
webflow.tar.gz
variables-*.json
notion-tokens-to-add.md
.npmrc
.env.1p

# ─── Visual regression (ADR-026) ─────────────────────────────────
# Diffs/actuals are CI artifacts, never committed. Only linux baselines
# (generated by the update-visual-baselines workflow's container) are real;
# platform-foreign baselines from accidental local runs stay out of git.
tests/visual/__diffs__/
.vitest-attachments/
tests/visual/__screenshots__/*-darwin.png
tests/visual/__screenshots__/*-win32.png
# vitest JSON report the visual job feeds to scripts/classify-visual-failure.mjs
# (#1778) — a per-run artifact, uploaded on failure, never committed.
visual-report.json
