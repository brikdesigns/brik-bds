---
/**
 * CardGrid — generic section wrapper for any "header + grid of items"
 * layout. Astro twin of `../react/CardGrid.tsx`. Content-agnostic by
 * design: serves services, blog posts, customer stories, property
 * listings, team bios, support plans, etc.
 *
 * Per the alignment ritual on brik-bds#580, the original `Services`
 * framing was content-coupled. `bds-card-grid` is the structural primitive.
 *
 * Two call paths (#2302):
 *
 *   - **Composed** — fill the default `<slot />` with whatever items belong
 *     in the grid. The block renders the header and gets out of the way.
 *   - **Dispatched** — pass `section.items` and a `layout`, and the block
 *     renders the items itself. This absorbs the two former per-layout files,
 *     `Services3ColCardGrid.astro` and `ServicesDetailTwoColumn.astro`, which
 *     wrapped this same primitive with hand-rolled item markup:
 *
 *       card-grid       — 3-up bordered cards with media, category pill,
 *                         optional CTA (styled by `.bp-services-grid__*`)
 *       two-column-list — 2-up plain title/description rows, no card
 *                         surface (styled by `.bp-services-two-col__*`)
 *
 * The `layout` prop selects the item markup below; it does not emit a
 * `bds-card-grid--<layout>` modifier class. That modifier carried no CSS
 * rule in either rail (the layouts are styled by the `bp-*` classes above),
 * so it was a dead `bds-*` hook the canonical gate correctly flagged once the
 * pre-rendered stories spelled it out — dropped per ADR-040.
 *
 * Slot content wins when present, so a composed consumer is unaffected by the
 * `layout` default.
 *
 * `CardGridLayout` is imported from `./types`, the contract module both rails
 * share. The React rail expresses the same two layouts through composed
 * children (its `Services3ColCardGrid` / `ServicesDetailTwoColumn` adapters),
 * because React blueprints can pass nodes and Astro dispatch cannot.
 *
 * The rendered marker is this block's own `card_grid`, not the dispatching
 * key — unchanged from the pre-consolidation adapters, which emitted nothing
 * of their own and inherited it from here. `scripts/verify-blueprints-astro-
 * exports.mjs` encodes that in `MARKER_OVERRIDES`.
 *
 * Slots used (all on docs/SLOT-ALLOWLIST.md):
 *   bds-card-grid, __container, __header, __subtitle, __title, __description
 *
 * Token pairs — paired family ↔ size only:
 *   subtitle    : --bds-font-family-subtitle + --bds-subtitle-lg + --bds-text-transform-subtitle
 *   title (h2)  : --bds-font-family-heading  + clamp(--bds-heading-lg, ..., --bds-heading-xl)
 *   description : --bds-font-family-body     + --bds-body-md
 *   item title  : --bds-font-family-heading  + --bds-heading-md
 *   item desc   : --bds-font-family-body     + --bds-body-md
 */
import type { BlueprintColumns, BlueprintProps, CardGridLayout } from './types';
import Media from './_Media.astro';

export interface Props extends BlueprintProps {
  /**
   * Item layout used when `section.items` drives the grid. Ignored when the
   * default slot carries composed content. Defaults to `card-grid`.
   */
  layout?: CardGridLayout;
  /**
   * Column count at the widest breakpoint for the DISPATCHED `card-grid` item
   * layout (structure axis, ADR-039). Omitted → the responsive default ramp
   * (1 → 2 → 3). Emits the enum-bound `bds-card-grid--cols-*` modifier. No
   * effect on composed children (the consumer owns their own grid) or on the
   * `two-column-list` layout. The React rail delegates column count to the
   * consumer's `<Grid columns>` instead, so this prop is Astro-only (#2492).
   */
  columns?: BlueprintColumns;
}

// Shared section shell (ADR-021) — global, unscoped; Astro dedupes it.
import '../section-shell.css';

const { section, layout = 'card-grid', columns } = Astro.props;

const titleId = `${section.sectionKey}-title`;
const title = section.heading ?? '';
const subtitle = section.subheading ?? undefined;
const description = section.body ?? undefined;

// Composed children take precedence over the section-driven item layouts, so
// a direct `<CardGrid><ul>…</ul></CardGrid>` consumer is unaffected.
const hasComposedItems = Astro.slots.has('default');

// The column-count modifier binds only to the dispatched `card-grid` item grid.
const showsDispatchedGrid = !hasComposedItems && layout === 'card-grid';
const sectionClass = [
  'bds-blueprint-section',
  'bds-card-grid',
  columns && showsDispatchedGrid ? `bds-card-grid--cols-${columns}` : null,
].filter(Boolean).join(' ');

const categoryLabels: Record<NonNullable<typeof section.items[number]['category']>, string> = {
  brand: 'Brand',
  marketing: 'Marketing',
  information: 'Information',
  product: 'Product',
  'back-office': 'Back Office',
  service: 'Back Office',
};
---

<section
  class={sectionClass}
  aria-labelledby={titleId}
  data-blueprint-key="card_grid"
>
  <div class="bds-blueprint-section__container">
    <header class="bds-card-grid__header">
      {subtitle && (
        <p class="bds-card-grid__subtitle">{subtitle}</p>
      )}
      <h2 id={titleId} class="bds-card-grid__title">{title}</h2>
      {description && (
        <p class="bds-card-grid__description">{description}</p>
      )}
    </header>

    {hasComposedItems ? (
      <slot />
    ) : layout === 'two-column-list' ? (
      <ul class="bp-services-two-col__list" role="list">
        {section.items.map((item) => (
          <li class="bp-services-two-col__item">
            <h3 class="bp-services-two-col__item-title">{item.title}</h3>
            <p class="bp-services-two-col__item-desc">{item.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="bp-services-grid__list" role="list">
        {section.items.map((item) => {
          const category = item.category ?? null;
          const categoryLabel = category ? categoryLabels[category] : null;
          return (
            <li class="bp-services-grid__item">
              <article
                class="bp-services-grid__card"
                data-category={category ?? undefined}
              >
                <div class="bp-services-grid__media">
                  {item.imageUrl ? (
                    <Media
                      media="image"
                      src={item.imageUrl}
                      alt={item.imageAlt ?? ''}
                      ratio="3-2"
                      fit="cover"
                    />
                  ) : (
                    categoryLabel && (
                      <span class="bp-services-grid__media-fallback" aria-hidden="true">
                        {categoryLabel}
                      </span>
                    )
                  )}
                  {item.hasOptions && (
                    <span class="bp-services-grid__has-options">Has Options</span>
                  )}
                </div>

                <div class="bp-services-grid__card-body">
                  {categoryLabel && (
                    <p class="bp-services-grid__category-row">
                      <span class="bp-services-grid__category-pill">
                        {categoryLabel}
                      </span>
                    </p>
                  )}
                  <h3 class="bp-services-grid__card-title">{item.title}</h3>
                  {item.description && (
                    <p class="bp-services-grid__card-desc">{item.description}</p>
                  )}
                  {item.href && (
                    <p class="bp-services-grid__cta-row">
                      <a class="bp-services-grid__cta" href={item.href}>
                        Learn more
                      </a>
                    </p>
                  )}
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>

<style>
  /* Mirrors ../react/CardGrid.css — the shared `bds-*` selectors are
     single-sourced by this mirror and covered by canonical-class-check
     against dist/styles.css (ADR-040). Values may differ where Astro
     hand-rolls what React composes; keep the `bds-*` vocabulary in sync. */

  /* Section rhythm + centred container: ../section-shell.css (ADR-021).
     The heavier bottom inset is a documented exception — unlayered here, so
     it outranks the layered `.bds-blueprint-section` shorthand. */
  .bds-card-grid {
    padding-block-end: clamp(
      var(--bds-padding-huge),
      9vw,
      calc(var(--bds-padding-huge) * 1.5)
    );
  }

  .bds-card-grid__header {
    max-width: var(--bds-content-width-text-md);
    margin-bottom: var(--bds-padding-xl);
    display: flex;
    flex-direction: column;
  }

  /* Content rhythm (ADR-023 §3), mirroring the React twin in CardGrid.css:
     subtitle→title is tight (--bds-gap-sm), title→description is medium
     (--bds-gap-md). */

  .bds-card-grid__header > * + * {
    margin-top: var(--bds-gap-md);
  }

  .bds-card-grid__subtitle + .bds-card-grid__title {
    margin-top: var(--bds-gap-sm);
  }

  .bds-card-grid__subtitle {
    margin: 0;
    font-family: var(--bds-font-family-subtitle);
    font-size: var(--bds-subtitle-lg);
    font-weight: var(--bds-font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: var(--bds-text-transform-subtitle, uppercase);
    color: var(--bds-text-brand-primary);
  }

  .bds-card-grid__title {
    margin: 0;
    font-family: var(--bds-font-family-heading);
    font-size: clamp(var(--bds-heading-lg), 3.5vw, var(--bds-heading-xl));
    font-weight: var(--bds-font-weight-semibold);
    line-height: var(--bds-font-line-height-tight);
    color: var(--bds-text-primary);
  }

  .bds-card-grid__description {
    margin: 0;
    font-family: var(--bds-font-family-body);
    font-size: var(--bds-body-md);
    line-height: var(--bds-font-line-height-normal);
    color: var(--bds-text-primary);
  }

  /* ── --two-column-list item layout ──────────────────────────────
     Absorbed from ServicesDetailTwoColumn.astro (#2302). Not part of the
     bds-card-grid canon vocabulary — these `bp-` classes stay blueprint-local.
     Token pairs respect the family↔size discipline. */

  .bp-services-two-col__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--bds-gap-xl);
  }

  @media (min-width: 768px) {
    .bp-services-two-col__list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--bds-gap-xl) var(--bds-gap-huge);
    }
  }

  .bp-services-two-col__item {
    display: flex;
    flex-direction: column;
    gap: var(--bds-gap-md);
  }

  .bp-services-two-col__item-title {
    margin: 0;
    /* Pair: heading family + heading size. */
    font-family: var(--bds-font-family-heading);
    font-size: var(--bds-heading-md);
    font-weight: var(--bds-font-weight-semibold);
    line-height: var(--bds-font-line-height-tight);
    color: var(--bds-text-primary);
  }

  .bp-services-two-col__item-desc {
    margin: 0;
    /* Pair: body family + body size. */
    font-family: var(--bds-font-family-body);
    font-size: var(--bds-body-md);
    line-height: var(--bds-font-line-height-normal);
    color: var(--bds-text-primary);
  }

  /* ── --card-grid item layout ────────────────────────────────────
     Absorbed from Services3ColCardGrid.astro (#2302). Astro consumers can't
     import the React `<Card preset="display">` primitive, so the card markup
     stays hand-rolled HTML+CSS scoped to this block. */

  .bp-services-grid__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--bds-gap-lg);
  }

  @media (min-width: 768px) {
    .bp-services-grid__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .bp-services-grid__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── --cols-*: column-count axis (ADR-039 §1, #2492) ─────────────
     Caps the widest-breakpoint count on the dispatched card grid; the
     mobile/tablet ramp is preserved. Omitted → the default ramp above. The
     `bds-card-grid--cols-*` vocabulary is single-sourced in ../react/CardGrid.css
     so the class reaches dist/styles.css for canonical-class-check. */
  @media (min-width: 992px) {
    .bds-card-grid--cols-2 .bp-services-grid__list {
      grid-template-columns: repeat(2, 1fr);
    }

    .bds-card-grid--cols-3 .bp-services-grid__list {
      grid-template-columns: repeat(3, 1fr);
    }

    .bds-card-grid--cols-4 .bp-services-grid__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .bp-services-grid__item {
    display: flex;
  }

  .bp-services-grid__card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--bds-surface-primary);
    border: var(--bds-border-width-md) solid var(--bds-border-secondary);
    border-radius: var(--bds-border-radius-md);
    overflow: hidden;
  }

  .bp-services-grid__media {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--bds-surface-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Image media renders through the shared `<Media>` primitive (media axis,
     ADR-039 #2518) — the `<Frame>` root (`.bds-frame--ratio-3-2`) fills this
     3/2 box (width:100%) and its `.bds-block-media__img` sets object-fit:cover,
     so no `.bp-services-grid__image` rule is needed. The box + fallback framing
     below stay for the no-image path. */

  .bp-services-grid__media-fallback {
    /* Pair: heading family + heading size. */
    font-family: var(--bds-font-family-heading);
    font-size: var(--bds-heading-md);
    font-weight: var(--bds-font-weight-semibold);
    color: var(--bds-text-primary);
    opacity: 0.55;
    letter-spacing: 0.02em;
  }

  .bp-services-grid__has-options {
    position: absolute;
    top: var(--bds-gap-md);
    right: var(--bds-gap-md);
    padding: 4px 10px;
    background: var(--bds-background-positive);
    color: var(--bds-text-on-color-dark);
    /* Pair: label family + label size. */
    font-family: var(--bds-font-family-label);
    font-size: var(--bds-label-sm);
    font-weight: var(--bds-font-weight-semibold);
    letter-spacing: 0.02em;
    border-radius: 999px;
    line-height: 1.2;
    z-index: 1;
  }

  .bp-services-grid__card-body {
    display: flex;
    flex-direction: column;
    gap: var(--bds-gap-md);
    padding: var(--bds-padding-lg);
    flex: 1 1 auto;
  }

  .bp-services-grid__category-row {
    margin: 0;
    display: flex;
  }

  .bp-services-grid__category-pill {
    /* Tag — does not stretch; sits at natural width. */
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 4px 10px;
    background: var(--bds-surface-secondary);
    color: var(--bds-text-primary);
    /* Pair: label family + label size. */
    font-family: var(--bds-font-family-label);
    font-size: var(--bds-label-md);
    font-weight: var(--bds-font-weight-semibold);
    border-radius: 999px;
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .bp-services-grid__card[data-category='brand'] .bp-services-grid__category-pill {
    background: var(--bds-color-yellow-300);
    color: var(--bds-color-yellow-950);
  }
  .bp-services-grid__card[data-category='marketing'] .bp-services-grid__category-pill {
    background: var(--bds-color-green-300);
    color: var(--bds-color-green-950);
  }
  .bp-services-grid__card[data-category='information'] .bp-services-grid__category-pill {
    background: var(--bds-color-blue-300);
    color: var(--bds-color-blue-950);
  }
  .bp-services-grid__card[data-category='product'] .bp-services-grid__category-pill {
    background: var(--bds-color-purple-300);
    color: var(--bds-color-purple-950);
  }
  .bp-services-grid__card[data-category='back-office'] .bp-services-grid__category-pill,
  .bp-services-grid__card[data-category='service'] .bp-services-grid__category-pill {
    background: var(--bds-color-orange-300);
    color: var(--bds-color-orange-950);
  }

  .bp-services-grid__card-title {
    margin: 0;
    /* Pair: heading family + heading size. */
    font-family: var(--bds-font-family-heading);
    font-size: var(--bds-heading-md);
    font-weight: var(--bds-font-weight-semibold);
    line-height: var(--bds-font-line-height-tight);
    color: var(--bds-text-primary);
  }

  .bp-services-grid__card-desc {
    margin: 0;
    /* Pair: body family + body size. */
    font-family: var(--bds-font-family-body);
    font-size: var(--bds-body-md);
    line-height: var(--bds-font-line-height-normal);
    color: var(--bds-text-primary);
  }

  .bp-services-grid__cta-row {
    margin: 0;
    margin-top: auto;
  }

  .bp-services-grid__cta {
    /* Astro "Learn more" — primary-button styling without the React
       `<LinkButton variant="primary">` the React rail uses.
       --bds-text-on-color-dark = white (text on a dark/saturated background fill). */
    display: inline-flex;
    align-items: center;
    gap: var(--bds-gap-sm);
    padding: var(--bds-padding-sm) var(--bds-padding-lg);
    background: var(--bds-background-brand-primary);
    color: var(--bds-text-on-color-dark);
    text-decoration: none;
    border-radius: var(--bds-border-radius-sm);
    /* Pair: label family + label size. */
    font-family: var(--bds-font-family-label);
    font-size: var(--bds-label-md);
    font-weight: var(--bds-font-weight-semibold);
    line-height: 1.4;
  }

  .bp-services-grid__cta:hover {
    filter: brightness(0.95);
  }

  .bp-services-grid__cta:focus-visible {
    outline: 2px solid var(--bds-border-focus, var(--bds-text-brand-primary));
    outline-offset: 2px;
  }
</style>
