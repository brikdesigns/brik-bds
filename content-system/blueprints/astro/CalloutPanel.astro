---
/**
 * CalloutPanel — `bds-callout-panel` section primitive. Astro twin of
 * `../react/CalloutPanel.tsx` (Phase D, brik-bds#581). Section header
 * (subtitle + title + lead) above a plan-callout card, with an optional
 * `media` slot rendered beside the card.
 *
 * Per brik-bds#589 the default shape is the simple single-column callout
 * (eyebrow + heading + body + one CTA); fill the `media` slot only when a
 * decorative node is supplied. The `support_plan_callout_split` blueprint
 * key dispatches through `SupportPlanCalloutSplit.astro`.
 *
 * Slots used (all on docs/SLOT-ALLOWLIST.md):
 *   bds-callout-panel, __container, __header, __subtitle, __title,
 *   __description, __columns, __illustration, __main, __cta
 *
 * a11y: section uses h2 + aria-labelledby; plan title is an h3 nested
 * under the section h2. CTA passes AA at the canonical `md` button size
 * (16px label) — DO NOT downgrade to `sm` on this surface.
 */
import type { BlueprintCta } from './types';

export interface Props {
  sectionKey: string;
  title: string;
  subtitle?: string;
  description?: string;
  panelTitle: string;
  panelDescription?: string;
  cta?: BlueprintCta;
}

// Shared section shell (ADR-021) — global, unscoped; Astro dedupes it.
import '../section-shell.css';

const {
  sectionKey,
  title,
  subtitle,
  description,
  panelTitle,
  panelDescription,
  cta,
} = Astro.props;
const titleId = `${sectionKey}-title`;
const hasMedia = Astro.slots.has('media');
// Astro blueprints are static — only the link CTA form is renderable.
const ctaUrl = cta && 'url' in cta ? cta.url : undefined;
---

<section
  class="bds-blueprint-section bds-callout-panel"
  data-blueprint-key="support_plan_callout_split"
  data-has-media={hasMedia ? 'true' : 'false'}
  aria-labelledby={titleId}
>
  <div class="bds-blueprint-section__container">
    {(subtitle || title || description) && (
      <header class="bds-callout-panel__header">
        {subtitle && <p class="bds-callout-panel__subtitle">{subtitle}</p>}
        <h2 id={titleId} class="bds-callout-panel__title">{title}</h2>
        {description && (
          <p class="bds-callout-panel__description">{description}</p>
        )}
      </header>
    )}

    <div class="bds-callout-panel__columns">
      {hasMedia && (
        <div class="bds-callout-panel__illustration">
          <slot name="media" />
        </div>
      )}

      <article class="bds-callout-panel__main">
        <h3 class="bds-callout-panel__title">{panelTitle}</h3>
        {panelDescription && (
          <p class="bds-callout-panel__description">{panelDescription}</p>
        )}
        {cta && ctaUrl && (
          <a
            class="bds-button bds-button--primary bds-button--md bds-callout-panel__cta"
            href={ctaUrl}
          >
            <span class="bds-button__content">{cta.label}</span>
          </a>
        )}
      </article>
    </div>
  </div>
</section>

<style>
  /* Mirrors ../react/CalloutPanel.css — keep in sync until a unified CSS
     distribution lands across the React + Astro twins. */

  /* Section rhythm + centred container: ../section-shell.css (ADR-021).
     This family's rhythm moved from 9vw to the harmonised 7vw. */
  .bds-callout-panel {
    background: var(--bds-callout-panel-bg, var(--page-primary));
  }

  /* ── Section header ─────────────────────────────────────────── */

  .bds-callout-panel__header {
    text-align: center;
    max-width: var(--measure-lg);
    margin-inline: auto;
    margin-bottom: var(--padding-xl);
    display: flex;
    flex-direction: column;
  }

  /* Content rhythm (ADR-023 §3), mirroring the React twin in CalloutPanel.css:
     subtitle→title is tight (--gap-sm), title→description is medium
     (--gap-md). */

  .bds-callout-panel__header > * + * {
    margin-top: var(--gap-md);
  }

  .bds-callout-panel__subtitle + .bds-callout-panel__title {
    margin-top: var(--gap-sm);
  }

  .bds-callout-panel__subtitle {
    margin: 0;
    font-family: var(--font-family-label);
    font-size: var(--label-lg);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-brand-primary);
  }

  .bds-callout-panel__header .bds-callout-panel__title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: clamp(var(--heading-lg), 3.5vw, var(--heading-xl));
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-line-height-tight);
    color: var(--text-primary);
  }

  .bds-callout-panel__header .bds-callout-panel__description {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--heading-sm);
    line-height: var(--font-line-height-relaxed);
    color: var(--text-primary);
  }

  /* ── Two-column split ───────────────────────────────────────── */

  .bds-callout-panel__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--bds-callout-panel-gap, var(--gap-xl));
    align-items: center;
  }

  .bds-callout-panel[data-has-media='false'] .bds-callout-panel__columns {
    grid-template-columns: 1fr;
    max-width: 720px;
    margin-inline: auto;
  }

  @media (max-width: 991.98px) {
    .bds-callout-panel__columns {
      grid-template-columns: 1fr;
    }
  }

  .bds-callout-panel__illustration {
    order: 1;
  }
  .bds-callout-panel__main {
    order: 2;
  }

  /* ── Plan callout card ──────────────────────────────────────── */

  .bds-callout-panel__main {
    background: var(--bds-callout-panel-card-bg, var(--surface-secondary));
    border-radius: var(--bds-callout-panel-card-radius, var(--border-radius-lg));
    padding: var(--bds-callout-panel-card-pad, var(--padding-xl));
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    align-items: flex-start;
  }

  .bds-callout-panel__main .bds-callout-panel__title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: var(--heading-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-line-height-tight);
    color: var(--text-primary);
  }

  .bds-callout-panel__main .bds-callout-panel__description {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--body-xl);
    line-height: var(--font-line-height-relaxed);
    color: var(--text-primary);
  }

  .bds-callout-panel__cta {
    margin-top: var(--gap-md);
  }
</style>
