---
/**
 * SiteHeader — the BDS site-header component. Dispatches on the
 * `archetype` prop to render one of the locked navigation archetypes
 * from the vocabulary (`NAV_ARCHETYPE_VALUES`).
 *
 * v0.1 implements ONE archetype in full: `editorial-transparent`.
 * This is the default for both the `small-business` pack (which Vale
 * resolves to) and the `dental` pack. Every other archetype value
 * currently renders the editorial-transparent markup with a
 * `data-unimplemented-archetype="<value>"` attribute on the header,
 * which CI can grep for in client repos whose pack picks a not-yet-
 * implemented archetype. Future PRs fill in the render paths for
 * `utility-first`, `service-centric`, `portfolio-minimal`, `calm-flat`.
 *
 * This is NOT a blueprint — SiteHeader takes direct site-shell props,
 * not BlueprintProps. It lives in `@brikdesigns/bds/blueprints-astro`
 * alongside the blueprints because that package is the package every
 * client Astro site imports for shell + sections.
 *
 * ## Props
 *
 *   archetype       — ResolvedNavArchetype (v0.1: only
 *                     'editorial-transparent' fully implemented)
 *   brandName       — site brand label (rendered as the logo text fallback)
 *   logoUrl         — optional logo image URL (when null, brandName is rendered as text)
 *   phone           — optional phone number (rendered in utility cluster)
 *   navItems        — array of { label, href } for primary nav links
 *   primaryCta      — optional { label, href } for the header CTA button
 *   currentPath     — optional — when set, the matching navItem gets
 *                     `aria-current="page"` for AT
 *
 * ## Behavior (in-component runtime)
 *
 *   The component ships its own client `<script>` — the vocabularies
 *   (`scroll-behavior.ts`, `drawer-pattern.ts`) name `<SiteHeader>` as the
 *   consumer of these values, so the scroll + mobile-drawer behavior lives
 *   here rather than in each consumer's scaffold. `scrollBehavior` and
 *   `mobileDrawer` are emitted as `data-scroll-behavior` / `data-drawer-
 *   pattern` on the header; the script reads them to drive the runtime.
 *
 * ## editorial-transparent archetype
 *
 *   Layout at ≥768px: [logo] [primary nav links, centered] [phone + CTA]
 *   Layout at  <768px: [logo] [hamburger button + mobile drawer markup]
 *   Scroll:  transparent over hero at top, frosted glass past 80px — the
 *            transparent→frost transition is DEFERRED (tracked on #2373
 *            AC "scroll behaviors"); the component ships the `is-scrolled`
 *            state hook the CSS keys off, not the transparency itself yet.
 *   Drawer:  fullscreen-overlay (mobile).
 *
 * ## utility-first archetype
 *
 *   Task-surface header for real-estate / directory / multi-practice packs
 *   (5 primary links + mega-menu + task-led CTA). Always-solid background,
 *   never transparent, never hides on scroll — the top bar is a task
 *   surface, not a branding one. Gains a subtle elevation shadow once
 *   scrolled (`data-scrolled`). Mobile drawer: `slide-left-panel` — slides
 *   in from the left over a translucent scrim, leaving the page visible.
 *
 * ## a11y
 *
 *   - `<nav aria-label="Primary">` landmark.
 *   - Logo/brand is the first focusable element (logical tab order).
 *   - `aria-current="page"` on the active link.
 *   - Phone link uses `tel:` scheme with sanitized digits.
 *   - Mobile hamburger button has `aria-label`, `aria-expanded`,
 *     and `aria-controls` pointing at the drawer markup.
 *   - Focus-visible ring on every interactive surface.
 */
import type { ResolvedNavArchetype } from './types';
import type { ServicesMegaMenu } from '../../schema/industry-pack';
import type { ScrollBehavior, DrawerPattern } from '../../vocabularies';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  archetype: ResolvedNavArchetype;
  brandName: string;
  logoUrl?: string | null;
  phone?: string | null;
  navItems: readonly NavItem[];
  primaryCta?: { label: string; href: string } | null;
  currentPath?: string | null;
  /**
   * Optional Services / Practice Areas mega-menu. When set, the primary
   * nav item whose label matches `servicesMegaMenu.triggerLabel` renders
   * a disclosure trigger + flyout panel (hover + `:focus-within` in CSS;
   * the click toggle + `aria-expanded` sync ship with the scaffold layout
   * JS, matching the mobile-drawer pattern). Every other nav item stays a
   * plain link.
   */
  servicesMegaMenu?: ServicesMegaMenu | null;
  /**
   * Scroll behavior — emitted as `data-scroll-behavior`; the runtime
   * script reads it to decide the on-scroll state. Defaults to the
   * archetype's documented behavior when omitted.
   */
  scrollBehavior?: ScrollBehavior | null;
  /**
   * Mobile drawer pattern — emitted as `data-drawer-pattern`; drives the
   * drawer's slide direction + scrim in CSS and the open/close script.
   */
  mobileDrawer?: DrawerPattern | null;
}

const {
  archetype,
  brandName,
  logoUrl = null,
  phone = null,
  navItems,
  primaryCta = null,
  currentPath = null,
  servicesMegaMenu = null,
  scrollBehavior = null,
  mobileDrawer = null,
} = Astro.props;

const IMPLEMENTED_ARCHETYPES = ['editorial-transparent', 'utility-first'] as const;
const isImplemented = (IMPLEMENTED_ARCHETYPES as readonly string[]).includes(archetype);

const phoneHref = phone ? `tel:${phone.replace(/[^+\d]/g, '')}` : null;

function isCurrent(href: string): boolean {
  if (!currentPath) return false;
  // Exact match OR (section match: current starts with href + '/')
  if (currentPath === href) return true;
  if (href !== '/' && currentPath.startsWith(href + '/')) return true;
  return false;
}

// The nav item that owns the Services mega-menu — matched by label so the
// pack's `primaryLinks` order drives placement, not a hardcoded slot.
const megaMenuTriggerLabel = servicesMegaMenu?.triggerLabel ?? null;
---

<header
  class:list={[
    'bp-site-header',
    `bp-site-header--${archetype}`,
  ]}
  data-nav-archetype={archetype}
  data-unimplemented-archetype={isImplemented ? undefined : archetype}
  data-scroll-behavior={scrollBehavior ?? undefined}
  data-drawer-pattern={mobileDrawer ?? undefined}
>
  <div class="bp-site-header__container">
    <a class="bp-site-header__brand" href="/" aria-label={`${brandName} home`}>
      {logoUrl ? (
        <img src={logoUrl} alt={brandName} class="bp-site-header__logo-image" />
      ) : (
        <span class="bp-site-header__brand-text">{brandName}</span>
      )}
    </a>

    <nav class="bp-site-header__nav" aria-label="Primary">
      <ul class="bp-site-header__nav-list" role="list">
        {navItems.map((item) => {
          const current = isCurrent(item.href);
          const isMegaTrigger =
            servicesMegaMenu !== null && item.label === megaMenuTriggerLabel;

          if (isMegaTrigger && servicesMegaMenu) {
            const panelId = 'bp-site-header-mega-services';
            return (
              <li class="bp-site-header__nav-item bp-site-header__nav-item--mega">
                {/* Disclosure trigger. CSS reveals the panel on :hover /
                    :focus-within; the scaffold layout JS drives the click
                    toggle + aria-expanded sync (deferred, matching the
                    mobile drawer). The `href` keeps the trigger a working
                    link to the section index when JS is absent. */}
                <a
                  href={item.href}
                  class="bp-site-header__nav-link bp-site-header__mega-trigger"
                  aria-current={current ? 'page' : undefined}
                  aria-expanded="false"
                  aria-controls={panelId}
                  aria-haspopup="true"
                  data-bp-site-header-mega-toggle
                >
                  {item.label}
                  <span class="bp-site-header__mega-chevron" aria-hidden="true"></span>
                </a>

                <div
                  id={panelId}
                  class="bp-site-header__mega"
                  data-bp-site-header-mega-panel
                >
                  <div class="bp-site-header__mega-inner">
                    <div
                      class="bp-site-header__mega-columns"
                      style={`--bds-site-header-mega-columns: ${servicesMegaMenu.columns}`}
                    >
                      {servicesMegaMenu.categories.map((category) => (
                        <div
                          class="bp-site-header__mega-column"
                          data-audience={category.audienceId ?? undefined}
                        >
                          <p class="bp-site-header__mega-heading">{category.heading}</p>
                          <ul class="bp-site-header__mega-list" role="list">
                            {category.items.map((entry) => (
                              <li>
                                <a href={entry.href} class="bp-site-header__mega-item">
                                  <span class="bp-site-header__mega-item-label">{entry.label}</span>
                                  {entry.note && (
                                    <span class="bp-site-header__mega-item-note">{entry.note}</span>
                                  )}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}

                      {servicesMegaMenu.featured && (
                        <a
                          href={servicesMegaMenu.featured.ctaHref}
                          class="bp-site-header__mega-featured"
                        >
                          <span class="bp-site-header__mega-featured-eyebrow">
                            {servicesMegaMenu.featured.eyebrow}
                          </span>
                          <span class="bp-site-header__mega-featured-heading">
                            {servicesMegaMenu.featured.heading}
                          </span>
                          <span class="bp-site-header__mega-featured-body">
                            {servicesMegaMenu.featured.body}
                          </span>
                          <span class="bp-site-header__mega-featured-cta">
                            {servicesMegaMenu.featured.ctaLabel}
                          </span>
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            );
          }

          return (
            <li class="bp-site-header__nav-item">
              <a
                href={item.href}
                class="bp-site-header__nav-link"
                aria-current={current ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="bp-site-header__actions">
      {phoneHref && (
        <a href={phoneHref} class="bp-site-header__phone">
          <span class="bp-site-header__phone-label" aria-hidden="true">Call</span>
          <span class="bp-site-header__phone-value">{phone}</span>
        </a>
      )}
      {primaryCta && (
        <a href={primaryCta.href} class="bp-site-header__cta">{primaryCta.label}</a>
      )}
    </div>

    <button
      type="button"
      class="bp-site-header__hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="bp-site-header-drawer"
      data-bp-site-header-toggle="open"
    >
      <span class="bp-site-header__hamburger-bar" aria-hidden="true"></span>
      <span class="bp-site-header__hamburger-bar" aria-hidden="true"></span>
      <span class="bp-site-header__hamburger-bar" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Scrim — only visible for slide-* drawer patterns (CSS gates it on
       [data-drawer-pattern]); a tap closes the drawer. Inert/hidden when
       the drawer is closed. -->
  <div
    class="bp-site-header__scrim"
    data-bp-site-header-scrim
    hidden
  ></div>

  <!-- Drawer is `inert` when closed — the runtime script removes `inert`,
       sets aria-expanded="true" on the hamburger, and locks body scroll.
       `inert` is preferred over aria-hidden here because it subsumes both
       the accessibility-tree hiding AND focus removal in one attribute —
       axe flags drawers that are aria-hidden with focusable children. -->
  <div
    id="bp-site-header-drawer"
    class="bp-site-header__drawer"
    inert
    data-bp-site-header-drawer
  >
    <div class="bp-site-header__drawer-head">
      <button
        type="button"
        class="bp-site-header__drawer-close"
        aria-label="Close menu"
        data-bp-site-header-toggle="close"
      >
        <span class="bp-site-header__drawer-close-bar" aria-hidden="true"></span>
        <span class="bp-site-header__drawer-close-bar" aria-hidden="true"></span>
      </button>
    </div>
    <nav class="bp-site-header__drawer-nav" aria-label="Primary mobile">
      <ul class="bp-site-header__drawer-list" role="list">
        {navItems.map((item) => (
          <li class="bp-site-header__drawer-item">
            <a href={item.href} class="bp-site-header__drawer-link">{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="bp-site-header__drawer-actions">
        {phoneHref && (
          <a href={phoneHref} class="bp-site-header__drawer-phone">{phone}</a>
        )}
        {primaryCta && (
          <a href={primaryCta.href} class="bp-site-header__drawer-cta">{primaryCta.label}</a>
        )}
      </div>
    </nav>
  </div>
</header>

<style>
  /* The base `.bp-site-header` shape stays archetype-neutral; each
   * `.bp-site-header--<archetype>` block below tweaks background, scroll,
   * and drawer behavior. Implemented: editorial-transparent, utility-first. */

  .bp-site-header {
    /* Per-client tuning */
    --bds-site-header-bg: var(--surface-navigation, transparent);
    --bds-site-header-text-color: var(--text-primary);
    --bds-site-header-cta-bg: var(--background-brand-primary);
    --bds-site-header-cta-color: var(--text-on-color-dark, var(--text-inverse));

    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bds-site-header-bg);
    padding-block: var(--padding-md);
    transition: box-shadow 160ms ease-out;
  }

  /* utility-first — always-solid task surface: never transparent, never
   * hides. Gains a subtle elevation shadow once the page is scrolled,
   * set by the runtime script via [data-scrolled]. */
  .bp-site-header--utility-first {
    --bds-site-header-bg: var(--surface-navigation);
  }

  .bp-site-header--utility-first[data-scrolled] {
    box-shadow: var(--shadow-sm);
  }

  .bp-site-header__container {
    max-width: var(--content-width-xl);
    margin-inline: auto;
    padding-inline: var(--padding-xl); /* bds-lint-ignore — legacy bp-* inset predates --gutter-page; realigning 32→24px is a visual change gated on Chromatic quota (#771), same deferral as #1630 */
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: var(--gap-lg);
  }

  .bp-site-header__brand {
    color: var(--bds-site-header-text-color);
    text-decoration: none;
    font-family: var(--font-family-heading);
    font-size: var(--heading-md);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
  }

  .bp-site-header__brand:focus-visible {
    outline: 2px solid var(--border-focus, var(--background-brand-primary));
    outline-offset: 4px;
  }

  .bp-site-header__logo-image {
    display: block;
    height: 32px;
    width: auto;
  }

  .bp-site-header__nav {
    display: none;
  }

  @media (min-width: 768px) {
    .bp-site-header__nav {
      display: block;
      justify-self: center;
    }
  }

  .bp-site-header__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--gap-lg);
  }

  .bp-site-header__nav-link {
    color: var(--bds-site-header-text-color);
    text-decoration: none;
    font-family: var(--font-family-label);
    font-size: var(--label-xl);
    font-weight: var(--font-weight-medium);
    padding: var(--padding-xs) 0;
    border-bottom: 2px solid transparent;
    transition: border-color 120ms ease-out;
  }

  .bp-site-header__nav-link:hover,
  .bp-site-header__nav-link[aria-current='page'] {
    border-bottom-color: var(--border-brand-primary);
  }

  .bp-site-header__nav-link:focus-visible {
    outline: 2px solid var(--border-focus, var(--background-brand-primary));
    outline-offset: 4px;
  }

  /* Services mega-menu — editorial-transparent's flyout. Disclosure is
   * CSS-only (hover + focus-within) so it works before the scaffold JS
   * loads; the JS then drives the click toggle + aria-expanded. Panel is
   * ≥768px only — on mobile the drawer carries the same links as flat
   * items (no nested mega-menu in the overlay). */
  .bp-site-header__nav-item--mega {
    position: relative;
  }

  .bp-site-header__mega-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-sm);
    cursor: pointer;
  }

  .bp-site-header__mega-chevron {
    width: 8px;
    height: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 120ms ease-out;
  }

  .bp-site-header__mega {
    display: none;
  }

  @media (min-width: 768px) {
    .bp-site-header__mega {
      display: block;
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      padding-top: var(--padding-md);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 120ms ease-out, visibility 0s linear 120ms;
      z-index: 200;
    }

    .bp-site-header__nav-item--mega:hover .bp-site-header__mega,
    .bp-site-header__nav-item--mega:focus-within .bp-site-header__mega {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition-delay: 0s;
    }

    .bp-site-header__nav-item--mega:hover .bp-site-header__mega-chevron,
    .bp-site-header__nav-item--mega:focus-within .bp-site-header__mega-chevron {
      transform: translateY(1px) rotate(225deg);
    }
  }

  .bp-site-header__mega-inner {
    background: var(--surface-primary);
    border: 1px solid var(--border-secondary);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--padding-xl);
    min-width: min(90vw, 720px);
  }

  .bp-site-header__mega-columns {
    display: grid;
    /* Column count is data-driven, set inline from servicesMegaMenu.columns
     * (always present — required field), so no fallback is needed. */
    grid-template-columns: repeat(var(--bds-site-header-mega-columns), minmax(0, 1fr));
    gap: var(--gap-xl);
  }

  .bp-site-header__mega-heading {
    margin: 0 0 var(--gap-md);
    color: var(--text-muted);
    font-family: var(--font-family-label);
    font-size: var(--label-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bp-site-header__mega-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .bp-site-header__mega-item {
    display: block;
    text-decoration: none;
    color: var(--text-primary);
  }

  .bp-site-header__mega-item:hover .bp-site-header__mega-item-label {
    color: var(--text-brand-primary);
  }

  .bp-site-header__mega-item:focus-visible {
    outline: 2px solid var(--border-focus, var(--background-brand-primary));
    outline-offset: 2px;
    border-radius: var(--border-radius-md);
  }

  .bp-site-header__mega-item-label {
    display: block;
    font-family: var(--font-family-label);
    font-size: var(--label-lg);
    font-weight: var(--font-weight-medium);
    transition: color 120ms ease-out;
  }

  .bp-site-header__mega-item-note {
    display: block;
    margin-top: 2px;
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-size: var(--body-sm);
  }

  .bp-site-header__mega-featured {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    padding: var(--padding-lg);
    background: var(--surface-secondary);
    border-radius: var(--border-radius-md);
    text-decoration: none;
    color: var(--text-primary);
  }

  .bp-site-header__mega-featured:focus-visible {
    outline: 2px solid var(--border-focus, var(--background-brand-primary));
    outline-offset: 2px;
  }

  .bp-site-header__mega-featured-eyebrow {
    color: var(--text-brand-primary);
    font-family: var(--font-family-label);
    font-size: var(--label-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bp-site-header__mega-featured-heading {
    font-family: var(--font-family-heading);
    font-size: var(--heading-sm);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
  }

  .bp-site-header__mega-featured-body {
    color: var(--text-secondary);
    font-family: var(--font-family-body);
    font-size: var(--body-sm);
  }

  .bp-site-header__mega-featured-cta {
    margin-top: var(--gap-sm);
    color: var(--text-brand-primary);
    font-family: var(--font-family-label);
    font-size: var(--label-lg);
    font-weight: var(--font-weight-semibold);
  }

  .bp-site-header__actions {
    display: none;
  }

  @media (min-width: 768px) {
    .bp-site-header__actions {
      display: flex;
      align-items: center;
      gap: var(--gap-md);
    }
  }

  .bp-site-header__phone {
    color: var(--bds-site-header-text-color);
    text-decoration: none;
    font-family: var(--font-family-label);
    font-size: var(--label-xl);
    font-weight: var(--font-weight-medium);
  }

  .bp-site-header__phone-label {
    display: none;
  }

  .bp-site-header__phone:focus-visible {
    outline: 2px solid var(--border-focus, var(--background-brand-primary));
    outline-offset: 2px;
  }

  .bp-site-header__cta {
    padding: var(--padding-sm) var(--padding-md);
    background: var(--bds-site-header-cta-bg);
    color: var(--bds-site-header-cta-color);
    font-family: var(--font-family-label);
    font-size: var(--label-xl);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    border-radius: var(--border-radius-md);
    transition: background 120ms ease-out;
  }

  .bp-site-header__cta:hover {
    background: var(--background-brand-primary-hover, var(--background-brand-primary));
  }

  .bp-site-header__cta:focus-visible {
    outline: 2px solid var(--border-focus, var(--background-brand-primary));
    outline-offset: 2px;
  }

  .bp-site-header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    justify-self: end;
  }

  @media (min-width: 768px) {
    .bp-site-header__hamburger {
      display: none;
    }
  }

  .bp-site-header__hamburger:focus-visible {
    outline: 2px solid var(--border-focus, var(--background-brand-primary));
    outline-offset: 2px;
  }

  .bp-site-header__hamburger-bar {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--bds-site-header-text-color);
    margin-inline: auto;
  }

  /* Drawer: hidden by default on all viewports. The scaffold layout's
   * header JS removes the `inert` attribute + flips aria-expanded on
   * the hamburger when the drawer opens. Using `inert` (not
   * aria-hidden) keeps the drawer out of the accessibility tree AND
   * removes its links from the tab order while closed. */
  .bp-site-header__drawer {
    position: fixed;
    inset: 0;
    background: var(--bds-site-header-bg);
    padding: var(--padding-xl);
    display: none;
  }

  .bp-site-header__drawer:not([inert]) {
    display: block;
  }

  .bp-site-header__drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .bp-site-header__drawer-link,
  .bp-site-header__drawer-phone,
  .bp-site-header__drawer-cta {
    color: var(--bds-site-header-text-color);
    text-decoration: none;
    font-family: var(--font-family-heading);
    font-size: var(--heading-lg);
    display: block;
  }

  .bp-site-header__drawer-actions {
    margin-top: var(--gap-xl);
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  /* Drawer header — holds the close affordance. */
  .bp-site-header__drawer-head {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--gap-lg);
  }

  .bp-site-header__drawer-close {
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .bp-site-header__drawer-close:focus-visible {
    outline: 2px solid var(--border-focus, var(--background-brand-primary));
    outline-offset: 2px;
  }

  .bp-site-header__drawer-close-bar {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 2px;
    background: var(--bds-site-header-text-color);
  }

  .bp-site-header__drawer-close-bar:first-child {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .bp-site-header__drawer-close-bar:last-child {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* Scrim — the translucent backdrop behind a slide-* drawer. The base
   * fullscreen-overlay drawer covers the whole viewport, so no scrim
   * shows there; the runtime script only un-hides it for slide patterns. */
  .bp-site-header__scrim {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: var(--background-overlay);
    border: none;
  }

  .bp-site-header__scrim[hidden] {
    display: none;
  }

  /* slide-left-panel — the drawer becomes a bounded panel that slides in
   * from the left over the scrim, leaving the page visible (task-mode
   * nav). Overrides the base full-bleed drawer only for this pattern. */
  .bp-site-header[data-drawer-pattern='slide-left-panel'] .bp-site-header__drawer {
    /* Kept laid out (not display:none) so the slide transition fires;
     * `inert` still holds it out of the a11y tree + tab order when closed,
     * and translateX(-100%) parks it off-screen. */
    display: block;
    inset: 0 auto 0 0;
    width: min(88vw, 360px);
    z-index: 160;
    transform: translateX(-100%);
    transition: transform 200ms ease-out;
  }

  .bp-site-header[data-drawer-pattern='slide-left-panel'] .bp-site-header__drawer:not([inert]) {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-site-header[data-drawer-pattern='slide-left-panel'] .bp-site-header__drawer {
      transition: none;
    }
  }
</style>

<script>
  // SiteHeader runtime — owns the mobile-drawer toggle and the on-scroll
  // state hook. The vocabularies (scroll-behavior.ts, drawer-pattern.ts)
  // name <SiteHeader> as the consumer of these values, so the behavior
  // lives here rather than in each consumer's scaffold layout.
  const DESKTOP_QUERY = '(min-width: 768px)';

  function initSiteHeader(header: HTMLElement): void {
    const drawer = header.querySelector<HTMLElement>('[data-bp-site-header-drawer]');
    const scrim = header.querySelector<HTMLElement>('[data-bp-site-header-scrim]');
    const openBtn = header.querySelector<HTMLElement>('[data-bp-site-header-toggle="open"]');
    const closeBtn = header.querySelector<HTMLElement>('[data-bp-site-header-toggle="close"]');
    if (!drawer || !openBtn) return;

    const pattern = header.getAttribute('data-drawer-pattern') ?? '';
    const usesScrim = pattern.startsWith('slide-');
    let scrollY = 0;

    const isOpen = () => !drawer.hasAttribute('inert');

    function open(): void {
      if (isOpen()) return;
      drawer.removeAttribute('inert');
      openBtn!.setAttribute('aria-expanded', 'true');
      if (usesScrim && scrim) scrim.hidden = false;
      // Scroll-lock via position-fixing — body{overflow:hidden} does not
      // hold on iOS Safari; the documentElement still rubber-bands.
      scrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      document.body.classList.add('nav-menu-open');
      (closeBtn ?? drawer).focus?.();
    }

    function close(): void {
      if (!isOpen()) return;
      drawer.setAttribute('inert', '');
      openBtn!.setAttribute('aria-expanded', 'false');
      if (scrim) scrim.hidden = true;
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      document.body.classList.remove('nav-menu-open');
      window.scrollTo(0, scrollY);
      openBtn!.focus?.();
    }

    openBtn.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    scrim?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) close();
    });

    // Viewport guard — if the viewport crosses into desktop while the menu
    // is open (tablet rotation), auto-close so the body isn't left locked
    // while the desktop nav is in use.
    const mq = window.matchMedia(DESKTOP_QUERY);
    mq.addEventListener('change', (e) => {
      if (e.matches && isOpen()) close();
    });

    // On-scroll state hook — utility-first keys its elevation shadow off
    // [data-scrolled]. Always-solid archetypes never hide; this only
    // toggles the state attribute, never the layout.
    const onScroll = () => {
      if (window.scrollY > 8) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  document
    .querySelectorAll<HTMLElement>('.bp-site-header')
    .forEach(initSiteHeader);
</script>
