---
/**
 * stats_bar — horizontal row of proof-point stats on a dark
 * surface. Each item renders as { value, label } — item.title carries
 * the large number/string, item.description the caption underneath.
 *
 * Intentionally dark-surfaced (uses a surface-inverse token by
 * default) so this blueprint is visually distinct from the
 * adjacent body of the page and reads as a weighty proof moment.
 *
 * Contract: BlueprintProps.
 *   - section.heading (optional, rendered as visually-hidden label
 *     for the stats region to give assistive tech a name)
 *   - section.items[] — REQUIRED shape, each: { title, description }
 *     title = the number/string, description = the caption
 *   - section.contentMotion (optional) — `count-up` sweeps each number into view
 *     via the shared `_CountUp` partial (ADR-039 §Decision 2, #2529);
 *     omitted → `none` (static). The first block to adopt `count-up`.
 *
 * required_facts: []. Section-driven.
 *
 * CSS custom properties:
 *   --bds-stats-dark-bar-padding-y
 *   --bds-stats-dark-bar-bg        (default: var(--bds-surface-inverse))
 *   --bds-stats-dark-bar-value-color   (default: var(--bds-text-inverse))
 *   --bds-stats-dark-bar-label-color   (default: var(--bds-text-inverse))
 *   --bds-stats-dark-bar-divider       (default: var(--bds-border-secondary))
 *
 * a11y: semantic list (ul/li). If section.heading present, wired via
 * aria-labelledby; if absent, aria-label fallback. Numbers are
 * content, not decoration — readable by screen readers.
 */
import type { BlueprintProps } from './types';
// The file is underscore-prefixed (a partial excluded from the reachability
// gate), but the imported identifier must be Capitalized for Astro to render it
// as a component rather than a literal tag — same as `_Media.astro` → `Media`.
import CountUp from './_CountUp.astro';

// Shared section shell (ADR-021) — global, unscoped; Astro dedupes it.
import '../section-shell.css';

interface Props extends BlueprintProps {}

const { section } = Astro.props;

const titleId = `${section.sectionKey}-title`;
const hasHeading = Boolean(section.heading);
const items = section.items;
// Content-motion axis (#2529): `count-up` sweeps each stat number into view via
// the shared `_CountUp` partial; the `bds-count-up` classes are canonical (from
// the primitive's own stylesheet). Omitted → `none` (static, unchanged).
const motion = section.contentMotion ?? 'none';
---

<section
  class="bp-stats-dark-bar"
  aria-labelledby={hasHeading ? titleId : undefined}
  aria-label={!hasHeading ? 'Key stats' : undefined}
  data-blueprint-key="stats_bar"
>
  <div class="bp-stats-dark-bar__container">
    {hasHeading && (
      <h2 id={titleId} class="bds-visually-hidden">{section.heading}</h2>
    )}
    <ul class="bp-stats-dark-bar__list" role="list">
      {items.map((item) => (
        <li class="bp-stats-dark-bar__item">
          <span class="bp-stats-dark-bar__value">
            {motion === 'count-up' ? <CountUp value={item.title} /> : item.title}
          </span>
          <span class="bp-stats-dark-bar__label">{item.description}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bp-stats-dark-bar {
    background: var(--bds-stats-dark-bar-bg, var(--bds-surface-inverse, var(--bds-color-grayscale-black)));
    padding-block: var(
      --bds-stats-dark-bar-padding-y,
      clamp(var(--bds-padding-lg), 5vw, var(--bds-padding-xl))
    );
  }

  .bp-stats-dark-bar__container {
    max-width: var(--bds-content-width-xl);
    margin-inline: auto;
    padding-inline: var(--bds-padding-xl); /* bds-lint-ignore — legacy bp-* inset predates --gutter-page; realigning 32→24px is a visual change gated on Chromatic quota (#771), same deferral as #1630 */
  }

  .bp-stats-dark-bar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--bds-gap-xl);
  }

  @media (min-width: 640px) {
    .bp-stats-dark-bar__list {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    }
  }

  .bp-stats-dark-bar__item {
    display: flex;
    flex-direction: column;
    /* Value↔label is a tight text pairing: --bds-gap-sm. Not --bds-gap-tiny, which
       resolves to 0px outside default spacing mode (ADR-023 §3). */
    gap: var(--bds-gap-sm);
    padding-block: var(--bds-padding-sm);
    border-left: 1px solid var(--bds-stats-dark-bar-divider, var(--bds-border-secondary));
    padding-left: var(--bds-padding-md);
  }

  @media (max-width: 639px) {
    .bp-stats-dark-bar__item {
      border-left: none;
      border-top: 1px solid var(--bds-stats-dark-bar-divider, var(--bds-border-secondary));
      padding-top: var(--bds-padding-md);
      padding-left: 0;
    }
    .bp-stats-dark-bar__item:first-child {
      border-top: none;
      padding-top: 0;
    }
  }

  .bp-stats-dark-bar__value {
    font-family: var(--bds-font-family-display, var(--bds-font-family-heading));
    font-size: clamp(var(--bds-heading-xl), 4vw, var(--bds-heading-huge));
    font-weight: var(--bds-font-weight-semibold);
    line-height: var(--bds-font-line-height-tight);
    color: var(--bds-stats-dark-bar-value-color, var(--bds-text-inverse, var(--bds-color-grayscale-white)));
  }

  .bp-stats-dark-bar__label {
    font-family: var(--bds-font-family-label);
    font-size: var(--bds-label-lg);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bds-stats-dark-bar-label-color, var(--bds-text-inverse, var(--bds-color-grayscale-100)));
  }
</style>
