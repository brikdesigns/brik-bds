---
/**
 * stats_dark_bar — horizontal row of proof-point stats on a dark
 * surface. Each item renders as { value, label } — item.title carries
 * the large number/string, item.description the caption underneath.
 *
 * Intentionally dark-surfaced (uses a surface-inverse token by
 * default) so this blueprint is visually distinct from the
 * adjacent body of the page and reads as a weighty proof moment.
 *
 * Contract: BlueprintProps.
 *   - section.heading (optional, rendered as visually-hidden label
 *     for the stats region to give assistive tech a name)
 *   - section.items[] — REQUIRED shape, each: { title, description }
 *     title = the number/string, description = the caption
 *
 * required_facts: []. Section-driven.
 *
 * CSS custom properties:
 *   --bds-stats-dark-bar-padding-y
 *   --bds-stats-dark-bar-bg        (default: var(--surface-inverse))
 *   --bds-stats-dark-bar-value-color   (default: var(--text-inverse))
 *   --bds-stats-dark-bar-label-color   (default: var(--text-inverse))
 *   --bds-stats-dark-bar-divider       (default: var(--border-secondary))
 *
 * a11y: semantic list (ul/li). If section.heading present, wired via
 * aria-labelledby; if absent, aria-label fallback. Numbers are
 * content, not decoration — readable by screen readers.
 */
import type { BlueprintProps } from './types';

// Shared section shell (ADR-021) — global, unscoped; Astro dedupes it.
import '../section-shell.css';

interface Props extends BlueprintProps {}

const { section } = Astro.props;

const titleId = `${section.sectionKey}-title`;
const hasHeading = Boolean(section.heading);
const items = section.items;
---

<section
  class="bp-stats-dark-bar"
  aria-labelledby={hasHeading ? titleId : undefined}
  aria-label={!hasHeading ? 'Key stats' : undefined}
  data-blueprint-key="stats_dark_bar"
>
  <div class="bp-stats-dark-bar__container">
    {hasHeading && (
      <h2 id={titleId} class="bds-visually-hidden">{section.heading}</h2>
    )}
    <ul class="bp-stats-dark-bar__list" role="list">
      {items.map((item) => (
        <li class="bp-stats-dark-bar__item">
          <span class="bp-stats-dark-bar__value">{item.title}</span>
          <span class="bp-stats-dark-bar__label">{item.description}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .bp-stats-dark-bar {
    background: var(--bds-stats-dark-bar-bg, var(--surface-inverse, var(--color-grayscale-black)));
    padding-block: var(
      --bds-stats-dark-bar-padding-y,
      clamp(var(--padding-lg), 5vw, var(--padding-xl))
    );
  }

  .bp-stats-dark-bar__container {
    max-width: var(--content-width-xl);
    margin-inline: auto;
    padding-inline: var(--padding-xl); /* bds-lint-ignore — legacy bp-* inset predates --gutter-page; realigning 32→24px is a visual change gated on Chromatic quota (#771), same deferral as #1630 */
  }

  .bp-stats-dark-bar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-xl);
  }

  @media (min-width: 640px) {
    .bp-stats-dark-bar__list {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    }
  }

  .bp-stats-dark-bar__item {
    display: flex;
    flex-direction: column;
    /* Value↔label is a tight text pairing: --gap-sm. Not --gap-2xs, which
       resolves to 0px outside default spacing mode (ADR-023 §3). */
    gap: var(--gap-sm);
    padding-block: var(--padding-sm);
    border-left: 1px solid var(--bds-stats-dark-bar-divider, var(--border-secondary));
    padding-left: var(--padding-md);
  }

  @media (max-width: 639px) {
    .bp-stats-dark-bar__item {
      border-left: none;
      border-top: 1px solid var(--bds-stats-dark-bar-divider, var(--border-secondary));
      padding-top: var(--padding-md);
      padding-left: 0;
    }
    .bp-stats-dark-bar__item:first-child {
      border-top: none;
      padding-top: 0;
    }
  }

  .bp-stats-dark-bar__value {
    font-family: var(--font-family-display, var(--font-family-heading));
    font-size: clamp(var(--heading-xl), 4vw, var(--heading-3xl));
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-line-height-tight);
    color: var(--bds-stats-dark-bar-value-color, var(--text-inverse, var(--color-grayscale-white)));
  }

  .bp-stats-dark-bar__label {
    font-family: var(--font-family-label);
    font-size: var(--label-lg);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bds-stats-dark-bar-label-color, var(--text-inverse, var(--color-grayscale-100)));
  }
</style>
