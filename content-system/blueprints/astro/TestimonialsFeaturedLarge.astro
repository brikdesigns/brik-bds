---
/**
 * testimonials_featured_large — one large, featured testimonial
 * centered on the page. Quote-first treatment; attribution below.
 * Used when a single client story carries disproportionate weight
 * (anchor case study, lead industry testimonial).
 *
 * Contract: BlueprintProps.
 *   - section.heading    — section label (h2, often "What clients say")
 *   - section.items[0]   — REQUIRED, the featured testimonial:
 *                            item.title       = attribution line
 *                                               (name · role · company)
 *                            item.description = the quote
 *                            item.videoUrl?   = optional testimonial video —
 *                                               rendered above the quote through
 *                                               the shared `<Media>` primitive
 *                                               (media axis, ADR-039 #2518)
 *                            item.videoPoster? = poster still (falls back to
 *                                                item.imageUrl)
 *
 * Media axis (ADR-039 #2518): when `items[0].videoUrl` is present the block
 * renders a foreground, user-controlled `media="video"` player (curated — not
 * free config) above the quote; reduced-motion-safe by construction (no
 * autoplay, `preload="metadata"`). Absent → the quote-only treatment,
 * unchanged.
 *
 * required_facts: []. Section-driven.
 *
 * CSS custom properties:
 *   --bds-testimonials-featured-padding-y
 *   --bds-testimonials-featured-bg         (default: var(--bds-surface-primary))
 *   --bds-testimonials-featured-quote-color (default: var(--bds-text-primary))
 *   --bds-testimonials-featured-cite-color  (default: var(--bds-text-secondary))
 *   --bds-testimonials-featured-mark-color  (default: var(--bds-text-brand-primary))
 *
 * a11y: h2 + aria-labelledby, semantic blockquote + cite. Decorative
 * quote mark uses aria-hidden so AT doesn't announce it.
 */
import type { BlueprintProps } from './types';
import Media from './_Media.astro';

// Shared section shell (ADR-021) — global, unscoped; Astro dedupes it.
import '../section-shell.css';

interface Props extends BlueprintProps {}

const { section } = Astro.props;
const titleId = `${section.sectionKey}-title`;
const featured = section.items[0];
---

<section
  class="bp-testimonials-featured"
  aria-labelledby={titleId}
  data-blueprint-key="testimonials_featured_large"
>
  <div class="bp-testimonials-featured__container">
    <h2 id={titleId} class="bds-visually-hidden">
      {section.heading ?? 'Featured testimonial'}
    </h2>

    {featured && featured.videoUrl && (
      <div class="bp-testimonials-featured__media">
        <Media
          media="video"
          src={featured.videoUrl}
          poster={featured.videoPoster ?? featured.imageUrl ?? undefined}
          ratio="16-9"
          fit="cover"
        />
      </div>
    )}

    {featured && (
      <blockquote class="bp-testimonials-featured__quote">
        <span class="bp-testimonials-featured__mark" aria-hidden="true">&ldquo;</span>
        <p class="bp-testimonials-featured__quote-text">{featured.description}</p>
        <cite class="bp-testimonials-featured__cite">{featured.title}</cite>
      </blockquote>
    )}
  </div>
</section>

<style>
  .bp-testimonials-featured {
    background: var(--bds-testimonials-featured-bg, var(--bds-surface-primary));
    padding-block: var(
      --bds-testimonials-featured-padding-y,
      clamp(var(--bds-padding-xl), 7vw, var(--bds-padding-huge))
    );
  }

  .bp-testimonials-featured__container {
    max-width: var(--bds-content-width-lg);
    margin-inline: auto;
    padding-inline: var(--bds-padding-xl); /* bds-lint-ignore — legacy bp-* inset predates --gutter-page; realigning 32→24px is a visual change gated on Chromatic quota (#771), same deferral as #1630 */
    text-align: center;
  }

  /* Media axis (ADR-039 #2518): the optional testimonial video sits above the
     quote, constrained to the quote's own measure and centred. The `<Media>`
     `<Frame>` root (`.bds-frame--ratio-16-9`) owns the aspect box. */
  .bp-testimonials-featured__media {
    max-width: var(--bds-content-width-text-sm);
    margin-inline: auto;
    margin-bottom: var(--bds-gap-xl);
  }

  .bp-testimonials-featured__quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--bds-gap-lg);
  }

  .bp-testimonials-featured__mark {
    font-family: var(--bds-font-family-display, var(--bds-font-family-heading));
    font-size: clamp(var(--bds-display-sm), 8vw, var(--bds-display-md));
    line-height: 1;
    color: var(--bds-testimonials-featured-mark-color, var(--bds-text-brand-primary));
  }

  .bp-testimonials-featured__quote-text {
    margin: 0;
    font-family: var(--bds-font-family-heading);
    font-size: clamp(var(--bds-heading-md), 2.5vw, var(--bds-heading-xl));
    font-weight: var(--bds-font-weight-medium);
    line-height: var(--bds-font-line-height-relaxed);
    color: var(--bds-testimonials-featured-quote-color, var(--bds-text-primary));
    max-width: var(--bds-content-width-text-sm);
  }

  .bp-testimonials-featured__cite {
    font-family: var(--bds-font-family-label);
    font-size: var(--bds-label-xl);
    font-style: normal;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bds-testimonials-featured-cite-color, var(--bds-text-secondary));
  }
</style>
