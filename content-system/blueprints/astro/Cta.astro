---
/**
 * Cta — canonical `bds-cta` closing-action block for the Astro rail (#2302).
 * Astro twin of `../react/Cta.tsx`: one file per block, layout as a prop.
 * Consolidates the two former per-layout files — `CtaDarkCentered.astro` and
 * `CtaSplitContact.astro` (both #582) — which implemented the same block
 * twice and were kept in sync by hand.
 *
 * Layouts are structural modifiers (ADR-008 §3), selected by `layout`:
 *
 *   default — centred single column on the inverse surface. The workhorse
 *             closing CTA. The former class baked theme (`dark`) + alignment
 *             (`centered`) into the name — both banned by ADR-008 §3, so the
 *             block is the structural `bds-cta` and the inverse surface is a
 *             themeable default, not part of the name.
 *   split   — `bds-cta--split`; messaging left, contact methods right. Phone +
 *             email render as tel:/mailto: links. The right column is the
 *             conversion surface when the visitor prefers direct contact.
 *
 * `CtaLayout` is imported from `./types`, the contract module both rails
 * share, so a layout cannot be added to one rail only.
 *
 * ── Contract ─────────────────────────────────────────────────────
 * Props: BlueprintProps + `layout`.
 *   - section.heading   — CTA headline (h2 for page hierarchy)
 *   - section.body      — optional supporting paragraph
 *   - section.cta       — primary action (label + url)
 *   - clientFacts.phone — `--split` only, REQUIRED
 *   - clientFacts.email — `--split` only, REQUIRED
 *
 * `blueprintKey` is supplied by `BlueprintDispatcher.astro` and rendered as
 * `data-blueprint-key`, so one block keeps emitting both distinct markers the
 * scaffold contract asserts on.
 *
 * ── required_facts ───────────────────────────────────────────────
 * `default`: none — section-driven. `split`: ['phone', 'email']. The scaffold
 * preflight gates the split layout before those are populated; if a fact
 * arrives null at runtime the blueprint emits a `data-content-needed` stub in
 * place of the missing method — CI grep on `dist/` blocks publish.
 *
 * ── CSS custom properties (Tier-4 hooks) ─────────────────────────
 *   --bds-cta-bg              (default: var(--surface-inverse);
 *                              --split: var(--surface-primary))
 *   --bds-cta-heading-color   (default: var(--text-inverse); --split: var(--text-primary))
 *   --bds-cta-body-color      (default: var(--text-inverse); --split: var(--text-secondary))
 *   --bds-cta-method-color    (--split only; default: var(--text-primary))
 *   --bds-cta-divider         (--split only; default: var(--border-secondary))
 *
 * ── a11y (WCAG 2.1 AA) ───────────────────────────────────────────
 * - h2 + aria-labelledby. The default layout is centre-aligned but reading
 *   order stays natural (heading → body → CTA).
 * - Contact methods use semantic tel:/mailto: anchors.
 * - :focus-visible ring with high contrast on every interactive surface.
 */
import type { BlueprintProps, CtaLayout, KnownBlueprintKey } from './types';

// Shared section shell (ADR-021) — global, unscoped; Astro dedupes it.
import '../section-shell.css';

interface Props extends BlueprintProps {
  /** Structural layout. Defaults to `default`, matching the React twin. */
  layout?: CtaLayout;
  /**
   * Blueprint key to emit as `data-blueprint-key`. Supplied by
   * `BlueprintDispatcher.astro`; omitted when the block is composed directly.
   */
  blueprintKey?: KnownBlueprintKey;
}

const { section, clientFacts, layout = 'default', blueprintKey } = Astro.props;

const titleId = `${section.sectionKey}-title`;
const isSplit = layout === 'split';
const phone = clientFacts.phone;
const email = clientFacts.email;

// The centred layout sits on the inverse surface and carries the page's one
// large closing action; the split layout's button shares its column with the
// contact aside and stays at the canonical md size.
const ctaClass = isSplit
  ? 'bds-button bds-button--primary bds-button--md'
  : 'bds-button bds-button--primary bds-button--lg';

const methods = isSplit
  ? [
      {
        fact: 'phone',
        label: 'Call',
        value: phone,
        href: phone ? `tel:${phone.replace(/[^+\d]/g, '')}` : null,
      },
      {
        fact: 'email',
        label: 'Email',
        value: email,
        href: email ? `mailto:${email}` : null,
      },
    ]
  : [];
---

<section
  class={`bds-blueprint-section bds-cta${isSplit ? ' bds-cta--split' : ''}`}
  aria-labelledby={titleId}
  data-blueprint-key={blueprintKey}
>
  <div class="bds-blueprint-section__container bds-cta__container">
    <div class="bds-cta__message">
      <h2 id={titleId} class="bds-cta__title">{section.heading}</h2>
      {section.body && (
        <p class="bds-cta__description">{section.body}</p>
      )}
      {section.cta && 'url' in section.cta && (
        <div class="bds-cta__actions">
          <a href={section.cta.url} class={ctaClass}><span class="bds-button__content">{section.cta.label}</span></a>
        </div>
      )}
    </div>

    {isSplit && (
      <div class="bds-cta__aside">
        {methods.map((method) => (
          method.value && method.href ? (
            <a href={method.href} class="bds-cta__method">
              <span class="bds-cta__method-label">{method.label}</span>
              <span class="bds-cta__method-value">{method.value}</span>
            </a>
          ) : (
            <div class="bds-cta__method" data-content-needed={method.fact} role="presentation">
              <span class="bds-cta__method-label">{method.label}</span>
              <span class="bds-cta__method-value">{method.label === 'Call' ? 'Phone' : 'Email'} missing</span>
            </div>
          )
        ))}
      </div>
    )}
  </div>
</section>

<style>
  /* Mirrors ../react/Cta.css — keep in sync until a unified CSS distribution
     lands across the React + Astro twins. Layout-specific rules are
     modifier-scoped, which is what lets both former per-layout files share
     one stylesheet without colliding (#2302).

     Section rhythm + centred container: ../section-shell.css (ADR-021). */

  /* ── Shared spine ─────────────────────────────────────────────── */

  .bds-cta {
    background: var(--bds-cta-bg, var(--surface-inverse, var(--color-grayscale-black)));
  }

  .bds-cta__container {
    /* Narrower centred band than the shared default, with a wider inline
       inset to match. Deliberate, not drift (ADR-021 §3). */
    --bds-blueprint-section-content-width: var(--content-width-lg);
    --bds-blueprint-section-padding-inline: var(--padding-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md);
    text-align: center;
  }

  .bds-cta__message {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md);
  }

  .bds-cta__title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: clamp(var(--heading-xl), 4vw, var(--display-sm));
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-line-height-tight);
    color: var(--bds-cta-heading-color, var(--text-inverse, var(--color-grayscale-white)));
  }

  .bds-cta__description {
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--heading-sm);
    line-height: var(--font-line-height-relaxed);
    color: var(--bds-cta-body-color, var(--text-inverse, var(--color-grayscale-100)));
    max-width: 55ch;
  }

  .bds-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    /* Horizontal step between buttons. The step DOWN from the message block is
       the container's own gap — a margin-top here would stack on top of it
       (the additive case ADR-023 §3 rules out). */
    gap: var(--gap-md);
  }

  /* ── --split: message column + contact-method aside ─────────────── */

  .bds-cta--split {
    background: var(--bds-cta-bg, var(--surface-primary));
  }

  .bds-cta--split .bds-cta__container {
    /* The two-column CTA uses the shared full-width band, restored explicitly
       over the family's narrower default, with the cta family's wider inline
       inset (ADR-021 §3). */
    --bds-blueprint-section-content-width: var(--content-width-xl);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-xl);
    align-items: center;
    text-align: start;
  }

  @media (min-width: 768px) {
    .bds-cta--split .bds-cta__container {
      grid-template-columns: 3fr 2fr;
      gap: var(--gap-2xl);
    }
  }

  .bds-cta--split .bds-cta__message {
    align-items: flex-start;
    text-align: start;
  }

  .bds-cta--split .bds-cta__title {
    font-size: clamp(var(--heading-lg), 3.5vw, var(--heading-xl));
    color: var(--bds-cta-heading-color, var(--text-primary));
  }

  .bds-cta--split .bds-cta__description {
    color: var(--bds-cta-body-color, var(--text-secondary));
  }

  .bds-cta--split .bds-cta__actions {
    justify-content: flex-start;
  }

  .bds-cta__aside {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    border-left: 1px solid var(--bds-cta-divider, var(--border-secondary));
    padding-inline-start: var(--padding-lg);
  }

  @media (max-width: 767px) {
    .bds-cta__aside {
      border-left: none;
      border-top: 1px solid var(--bds-cta-divider, var(--border-secondary));
      padding-top: var(--padding-lg);
      padding-inline-start: 0;
    }
  }

  .bds-cta__method {
    display: flex;
    flex-direction: column;
    /* Label↔value is a tight text pairing: --gap-sm. Not --gap-2xs, which
       resolves to 0px outside default spacing mode (ADR-023 §3). */
    gap: var(--gap-sm);
    color: var(--bds-cta-method-color, var(--text-primary));
    text-decoration: none;
    transition: color 120ms ease-out;
  }

  a.bds-cta__method:hover {
    color: var(--text-brand-primary);
  }

  a.bds-cta__method:focus-visible {
    outline: 2px solid var(--border-focus, var(--background-brand-primary));
    outline-offset: 2px;
  }

  .bds-cta__method-label {
    font-family: var(--font-family-label);
    font-size: var(--label-lg);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .bds-cta__method-value {
    font-family: var(--font-family-body);
    font-size: var(--heading-sm);
  }
</style>
