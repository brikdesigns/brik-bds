---
/**
 * BlueprintDispatcher — reads `section.visualNotes.blueprintKey` for
 * each section in the array and renders the corresponding Astro
 * component. Unknown keys render `<BlueprintFallback>`.
 *
 * This is the ONE component a client Astro page imports to render a
 * page body. No per-page if/else, no per-blueprint imports in client
 * repos. The scaffold task emits pages as:
 *
 *   <BlueprintDispatcher sections={page.sections}
 *                        clientFacts={...}
 *                        theme={...} />
 *
 * BLUEPRINT_REGISTRY is a static object — adding a new blueprint = one
 * import + one registry entry here + one export in index.ts. The
 * dispatcher's shape never changes.
 *
 * ## Contract
 *
 *   Props:
 *     - sections      — ordered array of BlueprintSection
 *     - clientFacts   — passed through to every blueprint
 *     - theme         — passed through to every blueprint
 *
 *   Behavior:
 *     - section.visualNotes.blueprintKey ∈ BLUEPRINT_REGISTRY →
 *         renders the matching component with full BlueprintProps plus the
 *         key's own `layout` / `blueprintKey` props
 *     - section.visualNotes.blueprintKey ∉ BLUEPRINT_REGISTRY →
 *         renders BlueprintFallback (which emits a
 *         data-blueprint-unknown-key attribute for CI grep)
 *     - section.visualNotes is null →
 *         same as unknown — falls back
 *
 * ## Registry — key → block + layout (#2302)
 *
 * Since #2302 the Astro rail is one component per BLOCK, with the layout
 * carried as a prop, matching the React API. The registry is therefore what
 * turns a blueprint key into a (block, layout) pair — the key is no longer a
 * filename. Six blocks cover the twelve wired keys:
 *
 *   hero_split                    → Hero            layout="split"
 *   hero_split_image_card_overlay → Hero            layout="with-pricing-card"
 *   hero_interior_minimal         → Hero            layout="interior-minimal"
 *   two_column_detail             → CardGrid        layout="two-column-list"
 *   card_grid                     → CardGrid        layout="card-grid"
 *   callout_split                 → CalloutPanel
 *   feature_grid                  → Features
 *   story_split                   → About
 *   stats_bar                     → StatsDarkBar
 *   testimonials_featured_large   → TestimonialsFeaturedLarge
 *   cta_split_contact             → Cta             layout="split"
 *   cta_centered                  → Cta             layout="default"
 *
 * `blueprintKey` is passed to the blocks that emit a per-key
 * `data-blueprint-key` marker (Hero, Cta, About, Features), so one file keeps
 * emitting the distinct markers the scaffold contract asserts on. CardGrid and
 * CalloutPanel emit their own block-level marker instead (`card_grid` /
 * `callout_split`) — unchanged from the adapters they absorbed,
 * which emitted nothing of their own. `scripts/verify-blueprints-astro-
 * exports.mjs` encodes that in `MARKER_OVERRIDES`.
 *
 * The registry key set is mirrored as the runtime export
 * `WIRED_BLUEPRINT_KEYS` in `./types` (the "is this blueprint implemented?"
 * surface consumers import) — `scripts/validate-blueprints.mjs` fails the
 * build if the two drift. When a new key ships, update BLUEPRINT_REGISTRY here
 * AND `WIRED_BLUEPRINT_KEYS` in the same PR.
 *
 * Since #2308 the registry IS blueprint-library.json's active set — every
 * `is_active: true` key dispatches here, so no active key falls through.
 * The designed-but-unbuilt layouts live in blueprints/blueprint-roadmap.json
 * and are deliberately absent from KnownBlueprintKey, so a consumer cannot
 * spell one. BlueprintFallback still handles a key that reaches the
 * dispatcher from stored page data written before its blueprint moved to the
 * roadmap — a real runtime case, no longer the expected steady state.
 */
import type { BlueprintSection, ClientFacts, ResolvedTheme } from './types';

import Hero from './Hero.astro';
import Cta from './Cta.astro';
import About from './About.astro';
import Features from './Features.astro';
import CardGrid from './CardGrid.astro';
import CalloutPanel from './CalloutPanel.astro';
import StatsDarkBar from './StatsDarkBar.astro';
import TestimonialsFeaturedLarge from './TestimonialsFeaturedLarge.astro';
import BlueprintFallback from './BlueprintFallback.astro';

// The registry. Key order doesn't matter; lookup is by key. Every entry's
// component accepts `BlueprintProps`; `props` carries the per-key extras
// (`layout`, and `blueprintKey` for the blocks that render the marker).
const BLUEPRINT_REGISTRY = {
  hero_split: { component: Hero, props: { layout: 'split', blueprintKey: 'hero_split' } },
  hero_split_image_card_overlay: { component: Hero, props: { layout: 'with-pricing-card', blueprintKey: 'hero_split_image_card_overlay' } },
  hero_interior_minimal: { component: Hero, props: { layout: 'interior-minimal', blueprintKey: 'hero_interior_minimal' } },
  two_column_detail: { component: CardGrid, props: { layout: 'two-column-list' } },
  card_grid: { component: CardGrid, props: { layout: 'card-grid' } },
  callout_split: { component: CalloutPanel, props: {} },
  feature_grid: { component: Features, props: { blueprintKey: 'feature_grid' } },
  story_split: { component: About, props: { blueprintKey: 'story_split' } },
  stats_bar: { component: StatsDarkBar, props: {} },
  testimonials_featured_large: { component: TestimonialsFeaturedLarge, props: {} },
  cta_split_contact: { component: Cta, props: { layout: 'split', blueprintKey: 'cta_split_contact' } },
  cta_centered: { component: Cta, props: { layout: 'default', blueprintKey: 'cta_centered' } },
} as const;

interface Props {
  sections: readonly BlueprintSection[];
  clientFacts: ClientFacts;
  theme: ResolvedTheme;
}

const { sections, clientFacts, theme } = Astro.props;
---

{sections.map((section) => {
  const key = section.visualNotes?.blueprintKey;
  const entry =
    key && key in BLUEPRINT_REGISTRY
      ? BLUEPRINT_REGISTRY[key as keyof typeof BLUEPRINT_REGISTRY]
      : null;
  if (!entry) {
    return <BlueprintFallback section={section} clientFacts={clientFacts} theme={theme} />;
  }
  const Component = entry.component;
  return (
    <Component section={section} clientFacts={clientFacts} theme={theme} {...entry.props} />
  );
})}
