---
/**
 * HeroMediaCardPrice — presentational hero media-card price block
 * (brik-bds#2312). Astro twin of `../react/HeroMediaCardPrice.tsx` — emits
 * the same `.bds-hero__price` / `__price-label` / `__price-value` markup,
 * class-identical to what `Hero.astro`'s `with-pricing-card` layout used to
 * inline directly (#2302). All three classes are already bundled into
 * `dist/styles.css` via the React twin (ADR-040 mirror coverage).
 *
 * Presentational only — renders no `<button>` / `<a>` itself. There is no
 * dedicated CTA prop: a caller (e.g. `Hero.astro`, or a consumer composing
 * `<HeroMediaCard>` directly) composes its own CTA link as the default slot,
 * which lands inside `.bds-hero__price` after the label/value — matching the
 * React twin's nesting. The root renders only when there is a label, value,
 * or slotted content to show (`Astro.slots.has('default')` stands in for the
 * React twin's `children` truthiness check — a slot passed with content that
 * itself renders empty still counts as present, which is the one place this
 * twin can't be byte-for-byte with the React check).
 *
 * Composes with `<HeroMediaCard>` after `<HeroMediaCardImage>`.
 *
 * @summary Hero media-card price block — label + value, class-identical to the React twin, with no CTA of its own.
 */
interface Props {
  /** Price label (e.g. "Starting at"). Only rendered when `value` is also set, matching the React twin. */
  label?: string;
  /** Price value (e.g. "$99/mo"). */
  value?: string;
  /** Extra class names, appended after the canonical `bds-hero__price` class. */
  class?: string;
}

const { label, value, class: className, ...rest } = Astro.props;
const hasSlotted = Astro.slots.has('default');
const shouldRender = Boolean(label) || Boolean(value) || hasSlotted;
---

{shouldRender && (
  <div class={['bds-hero__price', className].filter(Boolean).join(' ')} {...rest}>
    {label && value && <p class="bds-hero__price-label">{label}</p>}
    {value && <p class="bds-hero__price-value">{value}</p>}
    <slot />
  </div>
)}
