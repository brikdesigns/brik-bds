---
/**
 * Hero — canonical `bds-hero` page-hero block for the Astro rail (#2302).
 * Astro twin of `../react/Hero.tsx`: one file per block, layout as a prop.
 * Consolidates the three former per-layout files — `HeroSplit6040.astro`
 * (#583), `HeroInteriorMinimal.astro` (#583) and
 * `HeroSplitImageCardOverlay.astro` (#1165) — which implemented the same
 * block three times and were kept in sync by hand.
 *
 * The shared spine is a content column: (breadcrumb) → (eyebrow icon) →
 * eyebrow text → `h1` → lead → CTA. Layouts are structural modifiers
 * (ADR-008 §3), selected by the `layout` prop:
 *
 *   split             — `bds-hero--split`              content + media column (60/40)
 *   interior-minimal  — `bds-hero--interior-minimal`   narrow content column, no media
 *   with-pricing-card — `bds-hero--with-pricing-card`  content trail + image/price card
 *
 * `HeroLayout` is imported from `./types`, the contract module both rails
 * share, so a layout cannot be added to one rail only.
 *
 * Hero blueprints own the page's singular `h1`.
 *
 * ── Contract ─────────────────────────────────────────────────────
 * Props: BlueprintProps + `layout` (+ two `--with-pricing-card` options).
 *   - section.heading              — h1 (REQUIRED)
 *   - section.subheading           — eyebrow above h1 (optional)
 *   - section.body                 — lead paragraph (optional)
 *   - section.cta                  — primary CTA (optional)
 *   - clientFacts.heroImageUrl     — `--split` media column; emits a
 *     `data-content-needed="hero_image_url"` stub when missing (CI greppable)
 *   - section.breadcrumb           — `--with-pricing-card` trail (optional)
 *   - section.serviceLine          — `--with-pricing-card` service-line slug
 *                                    (`audience` is the @deprecated alias — #788)
 *   - section.iconUrl / iconAlt    — `--with-pricing-card` eyebrow icon (optional)
 *   - section.priceCard            — `--with-pricing-card` right column; emits the
 *                                    `data-content-needed` stub when absent
 *
 * `blueprintKey` is supplied by `BlueprintDispatcher.astro` and rendered as
 * `data-blueprint-key`, so one block keeps emitting the three distinct
 * markers the scaffold contract asserts on. Composing this block directly
 * (outside dispatch) emits no key marker — the same split the React rail
 * draws between `<Hero>` and its key adapters.
 *
 * ── required_facts ───────────────────────────────────────────────
 * `--split`: heroImageUrl (falls back to the stub). Other layouts: none.
 *
 * ── CSS custom properties (Tier-4 hooks) ─────────────────────────
 *   --bds-hero-bg              (--split / --interior-minimal: var(--page-primary);
 *                               --with-pricing-card: var(--page-secondary))
 *   --bds-hero-padding-y       (--with-pricing-card only; default: clamp block)
 *   --bds-hero-headline-color  (default: var(--text-primary))
 *   --bds-hero-eyebrow-color   (default: var(--text-brand-primary))
 *   --bds-hero-lead-color      (default: var(--text-secondary))
 *   --bds-hero-accent-line     (default: var(--border-brand-primary))
 *   --bds-hero-image-radius    (default: var(--border-radius-lg))
 *   --bds-hero-media-bg        (default: var(--surface-primary))
 *   --bds-hero-radius          (default: var(--border-radius-lg))
 *
 * ── a11y (WCAG 2.1 AA) ───────────────────────────────────────────
 * - Heading is h1 (hero blueprints own the page's singular h1).
 * - aria-labelledby wires the section landmark to the h1 id.
 * - Eyebrow is prose, not a heading.
 * - Breadcrumb uses the `bds-breadcrumb` pattern (nav + aria-label,
 *   aria-current="page" on the final crumb).
 * - Image alt: the decorative-default empty string (the h1 conveys meaning);
 *   the price-card image takes `section.priceCard.imageAlt` when informational.
 */
import type { BlueprintProps, HeroLayout, KnownBlueprintKey } from './types';

// Shared section shell (ADR-021) — global, unscoped; Astro dedupes it.
import '../section-shell.css';

/**
 * Aspect-ratio slug — mirrors the BDS `FrameRatio` vocabulary backed by the
 * `--aspect-*` token family (#486). Defined locally rather than imported from
 * the Frame component so this shipped blueprint stays self-contained for
 * consumer Astro builds.
 */
type FrameRatio =
  // Primitives
  | '1-1' | '3-2' | '2-3' | '4-3' | '3-4' | '4-5' | '16-9' | '9-16' | '21-9'
  // Semantic aliases
  | 'square' | 'photo-landscape' | 'photo-portrait' | 'cinema'
  // Deprecated mode-words (resolved via DEPRECATED_RATIO_ALIAS for one minor version)
  /** @deprecated Use `3-4`. */ | 'portrait'
  /** @deprecated Use `4-3`. */ | 'landscape'
  /** @deprecated Use `16-9` or `cinema`. */ | 'wide'
  /** @deprecated Use `21-9`. */ | 'ultrawide';

/**
 * Deprecated mode-words → canonical aspect primitive. Canonical slugs
 * (primitives + semantic aliases) resolve to `--aspect-{slug}` directly and
 * need no entry here. Delete this map when the mode-words are removed.
 */
const DEPRECATED_RATIO_ALIAS: Partial<Record<FrameRatio, string>> = {
  portrait: '3-4',
  landscape: '4-3',
  wide: '16-9',
  ultrawide: '21-9',
};

/** Resolves a FrameRatio slug to its `--aspect-*` token reference. */
const aspectToken = (ratio: FrameRatio): string =>
  `var(--aspect-${DEPRECATED_RATIO_ALIAS[ratio] ?? ratio})`;

interface Props extends BlueprintProps {
  /** Structural layout. Defaults to `split`, matching the React twin. */
  layout?: HeroLayout;
  /**
   * Blueprint key to emit as `data-blueprint-key`. Supplied by
   * `BlueprintDispatcher.astro`; omitted when the block is composed directly.
   */
  blueprintKey?: KnownBlueprintKey;
  /** `--with-pricing-card` image ratio. Ignored by the other layouts. */
  imageRatio?: FrameRatio;
  /**
   * When false, suppresses the eyebrow icon slot (raw `iconUrl` image or the
   * service-line-driven ServiceTag) while keeping `serviceLine` driving the
   * hero's `data-service-line` theming. Default true. (brik-bds#871)
   */
  showServiceTag?: boolean;
}

const {
  section,
  clientFacts,
  layout = 'split',
  blueprintKey,
  imageRatio = 'square',
  showServiceTag = true,
} = Astro.props;

const { breadcrumb = [], serviceLine, audience, iconUrl, iconAlt, priceCard } = section;
// `serviceLine` is canonical; `audience` is the deprecated alias (#788).
const resolvedServiceLine = serviceLine ?? audience;

const titleId = `${section.sectionKey}-title`;
const eyebrow = section.subheading;
const headline = section.heading ?? '';
const lead = section.body;
const cta = section.cta;

const isSplit = layout === 'split';
const isPricingCard = layout === 'with-pricing-card';
const heroImage = clientFacts.heroImageUrl;

// The pricing-card layout sits on an audience-tinted surface, so its single
// action is the inverse button; the other layouts use the primary fill.
const ctaClass = isPricingCard
  ? 'bds-button bds-button--inverse bds-button--md'
  : 'bds-button bds-button--primary bds-button--md';

// Non-square ratios drive the frame + stub through one custom property; the
// `--aspect-1-1` default lives in the stylesheet.
const ratioStyle =
  isPricingCard && imageRatio !== 'square'
    ? `--bds-hero-image-ratio: ${aspectToken(imageRatio)}`
    : undefined;
---

<section
  class={`bds-blueprint-section bds-hero bds-hero--${layout}`}
  aria-labelledby={titleId}
  data-blueprint-key={blueprintKey}
  data-service-line={isPricingCard ? resolvedServiceLine : undefined}
  data-audience={isPricingCard ? resolvedServiceLine : undefined}
>
  <div class="bds-blueprint-section__container bds-hero__container">
    <div class="bds-hero__content">
      {isPricingCard && breadcrumb.length > 0 && (
        <nav class="bds-breadcrumb bds-hero__breadcrumb" aria-label="Breadcrumb">
          {breadcrumb.map((item, idx) => {
            const isLast = idx === breadcrumb.length - 1;
            return (
              <span style="display: contents;">
                {idx > 0 && (
                  <span class="bds-breadcrumb__separator" aria-hidden="true">/</span>
                )}
                {isLast || !item.href ? (
                  <span
                    class="bds-breadcrumb__current"
                    aria-current={isLast ? 'page' : undefined}
                  >{item.label}</span>
                ) : (
                  <a href={item.href} class="bds-breadcrumb__link">{item.label}</a>
                )}
              </span>
            );
          })}
        </nav>
      )}

      {/*
        Eyebrow icon precedence (brik-bds#546) — `--with-pricing-card` only:
          1. iconUrl set → render raw <img> (legacy/decorative escape hatch)
          2. serviceLine set, no iconUrl → render canonical <ServiceTag variant="icon">
             markup inline (Astro can't import the React component; it emits
             the same `bds-service-tag*` classes so dist/styles.css renders
             it identically)
          3. neither → no eyebrow

        `showServiceTag={false}` suppresses this whole slot while leaving
        `data-service-line` theming intact (brik-bds#871).
      */}
      {isPricingCard && showServiceTag && (iconUrl ? (
        <img
          src={iconUrl}
          alt={iconAlt ?? ''}
          class="bds-hero__icon"
          loading="eager"
          decoding="async"
        />
      ) : resolvedServiceLine ? (
        <span
          class={`bds-service-tag bds-service-tag--icon bds-service-tag--icon-lg bds-service-tag--${resolvedServiceLine} bds-hero__icon`}
          role="img"
          aria-label={`${resolvedServiceLine} category`}
        />
      ) : null)}

      {eyebrow && <p class="bds-hero__subtitle">{eyebrow}</p>}

      <h1 id={titleId} class="bds-hero__title">{headline}</h1>

      {lead && <p class="bds-hero__lead">{lead}</p>}

      {cta && 'url' in cta && (
        <a href={cta.url} class={ctaClass}>
          <span class="bds-button__content">{cta.label}</span>
        </a>
      )}
    </div>

    {isSplit && (heroImage ? (
      <div class="bds-hero__media">
        <img
          src={heroImage}
          alt=""
          width="960"
          height="1200"
          loading="eager"
          decoding="async"
          class="bds-hero__image"
        />
      </div>
    ) : (
      <div
        class="bds-blueprint-section__missing bds-hero__missing"
        data-content-needed="hero_image_url"
        role="presentation"
      >
        <p class="bds-blueprint-section__missing-label">
          Hero image missing for this client.
        </p>
      </div>
    ))}

    {isPricingCard && (priceCard ? (
      <aside class="bds-hero__media-card">
        <div class="bds-hero__image-frame" style={ratioStyle}>
          <img
            src={priceCard.imageUrl}
            alt={priceCard.imageAlt ?? ''}
            loading="eager"
            decoding="async"
            class="bds-hero__image"
          />
        </div>
        {(priceCard.priceLabel || priceCard.price || priceCard.cta) && (
          <div class="bds-hero__price">
            {priceCard.priceLabel && priceCard.price && (
              <p class="bds-hero__price-label">{priceCard.priceLabel}</p>
            )}
            {priceCard.price && (
              <p class="bds-hero__price-value">{priceCard.price}</p>
            )}
            {priceCard.cta && 'url' in priceCard.cta && (
              <a href={priceCard.cta.url} class={`bds-button bds-button--primary bds-button--${priceCard.cta.size ?? 'sm'}`}>
                <span class="bds-button__content">{priceCard.cta.label}</span>
              </a>
            )}
          </div>
        )}
      </aside>
    ) : (
      <aside
        class="bds-blueprint-section__missing bds-hero__missing"
        data-content-needed="hero_image_url"
        role="presentation"
        style={ratioStyle}
      >
        <p class="bds-blueprint-section__missing-label">
          Hero image card missing for this page.
        </p>
      </aside>
    ))}
  </div>
</section>

<style>
  /* Mirrors ../react/Hero.css — keep in sync until a unified CSS distribution
     lands across the React + Astro twins. Every layout-specific rule is
     modifier-scoped, which is what lets the three former per-layout files
     share one stylesheet without colliding (#2302).

     Section rhythm + centred container: ../section-shell.css (ADR-021). */

  /* ── Shared spine ─────────────────────────────────────────────── */

  .bds-hero {
    background: var(--bds-hero-bg, var(--page-primary));
  }

  .bds-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Content rhythm (ADR-023 §3), mirroring the React twin in Hero.css:
     eyebrow→title is tight (--gap-sm), title→lead is medium (--gap-md).
     Composed slots (breadcrumb, eyebrow icon, CTA) take the medium default. */

  .bds-hero__content > * + * {
    margin-top: var(--gap-md);
  }

  .bds-hero__subtitle + .bds-hero__title {
    margin-top: var(--gap-sm);
  }

  .bds-hero__subtitle {
    margin: 0;
    font-family: var(--font-family-label);
    font-size: var(--label-lg);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bds-hero-eyebrow-color, var(--text-brand-primary));
  }

  .bds-hero__title {
    margin: 0;
    font-family: var(--font-family-heading);
    font-size: clamp(var(--heading-xl), 4vw, var(--display-sm));
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-line-height-tight);
    color: var(--bds-hero-headline-color, var(--text-primary));
  }

  .bds-hero__lead {
    /* Rhythm comes from the `> * + *` adjacency above — a margin here would
       stack on top of it (the additive case ADR-023 §3 rules out). */
    margin: 0;
    font-family: var(--font-family-body);
    font-size: var(--heading-sm);
    line-height: var(--font-line-height-relaxed);
    color: var(--bds-hero-lead-color, var(--text-secondary));
  }

  /* `--interior-minimal` deliberately omits the measure cap: its container is
     already clamped to --measure-lg, and the pre-consolidation file carried no
     max-width here. Scoped rather than shared so consolidating changed no
     layout's rendering (#2302). */
  .bds-hero--split .bds-hero__lead,
  .bds-hero--with-pricing-card .bds-hero__lead {
    max-width: 55ch;
  }

  .bds-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Non-hallucinatable content stub — CI grep on data-content-needed. The
     aspect-ratio is layout-scoped below; only the corner radius is shared. */
  .bds-hero__missing {
    border-radius: var(--bds-hero-image-radius, var(--border-radius-lg));
  }

  /* ── --interior-minimal: single narrow content column, no media ── */

  /* Narrow reading column + wider inline inset — a deliberate modifier-scoped
     exception to the shared container (ADR-021 §3), matching the React twin's
     `.bds-hero--interior-minimal .bds-hero__container` rule. */
  .bds-hero--interior-minimal .bds-hero__container {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    max-width: var(--measure-lg);
    --bds-blueprint-section-padding-inline: var(--padding-xl);
  }

  /* ── --split: content column + media column (60/40) ─────────────── */

  .bds-hero--split .bds-hero__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-xl);
    align-items: center;
  }

  @media (min-width: 768px) {
    .bds-hero--split .bds-hero__container {
      grid-template-columns: 3fr 2fr;
      gap: var(--gap-2xl);
    }

    .bds-hero--split .bds-hero__title::after {
      content: '';
      display: block;
      width: 3rem;
      height: 2px;
      margin-top: var(--gap-lg);
      background: var(--bds-hero-accent-line, var(--border-brand-primary));
    }
  }

  .bds-hero--split .bds-hero__title {
    font-size: clamp(var(--heading-2xl), 5vw, var(--display-sm));
    position: relative;
  }

  .bds-hero--split .bds-hero__media {
    aspect-ratio: var(--aspect-4-5);
    overflow: hidden;
    border-radius: var(--bds-hero-image-radius, var(--border-radius-lg));
  }

  .bds-hero--split .bds-hero__missing {
    aspect-ratio: var(--aspect-4-5);
  }

  /* ── --with-pricing-card: interior split (content trail + image/price card) ──
   *
   * Consolidates the former bp-hero-img-card blueprint (brik-bds#1165). Left
   * column: breadcrumb + eyebrow icon + eyebrow text + h1 + lead + inverse CTA on
   * a soft audience-tinted surface. Right column: an `aside` white card with the
   * page image + optional price overlay + price CTA.
   *
   * The tighter interior rhythm is a documented modifier-level exception —
   * twin-consistent with React `Hero.css`, and unlayered so it outranks
   * `.bds-blueprint-section`. */

  .bds-hero--with-pricing-card {
    background: var(--bds-hero-bg, var(--page-secondary));
    padding-block: var(
      --bds-hero-padding-y,
      clamp(var(--padding-xl), 6vw, var(--padding-2xl))
    );
  }

  /* Service-line cascade — canonical --*-service-{service-line} tokens.
   *
   * Background uses the `surface` family (not `background`) because the hero
   * is a broad page-level container, not a small bounded component — per the
   * service-token decision tree (`-surface-` for sections/heroes/cards;
   * `-background-` for badges/tags/pills/buttons). It uses the `-inverse` step
   * (ADR-012): the card reads as neutral chrome — white — in light mode, then
   * carries the line's deep {hue}-darkest tint in dark mode. The companion text
   * flip lives in the dark-mode block below (brik-bds#1017).
   *
   * `--background-inverse` stays on the `background` family: it's the
   * mode-aware companion fill consumed by the inverse `<Button>` variant
   * inside the hero, which IS a small bounded component.
   *
   * `data-service-line` is canonical; `data-audience` is the @deprecated alias
   * kept for component-API compat during the cross-repo rename (#788). Both are
   * emitted during the deprecation window, so every rule below dual-targets
   * `:is([data-audience='X'], [data-service-line='X'])` (mirrors React `Hero.css`).
   *
   * Note: the `data-*='service'` attribute value still reads "service" for
   * back-office compat; the underlying tokens were renamed `service-service` →
   * `service-back-office` in #563 (orange line — back office). Removal of the
   * `data-audience` attribute is a separate cross-repo follow-up (#788 step 4). */
  .bds-hero--with-pricing-card:is([data-audience='brand'], [data-service-line='brand']) {
    background: var(--surface-service-brand-inverse);
    --bds-hero-headline-color: var(--text-service-brand-on-light);
    --bds-hero-eyebrow-color: var(--text-service-brand-on-light);
    --bds-hero-lead-color: var(--text-service-brand-on-light);
    --text-brand-primary: var(--text-service-brand-on-light);
    --background-inverse: var(--surface-service-brand-dark);
    --text-on-color-light: var(--color-grayscale-white);
  }
  .bds-hero--with-pricing-card:is([data-audience='marketing'], [data-service-line='marketing']) {
    background: var(--surface-service-marketing-inverse);
    --bds-hero-headline-color: var(--text-service-marketing-on-light);
    --bds-hero-eyebrow-color: var(--text-service-marketing-on-light);
    --bds-hero-lead-color: var(--text-service-marketing-on-light);
    --text-brand-primary: var(--text-service-marketing-on-light);
    --background-inverse: var(--surface-service-marketing-dark);
    --text-on-color-light: var(--color-grayscale-white);
  }
  .bds-hero--with-pricing-card:is([data-audience='information'], [data-service-line='information']) {
    background: var(--surface-service-information-inverse);
    --bds-hero-headline-color: var(--text-service-information-on-light);
    --bds-hero-eyebrow-color: var(--text-service-information-on-light);
    --bds-hero-lead-color: var(--text-service-information-on-light);
    --text-brand-primary: var(--text-service-information-on-light);
    --background-inverse: var(--surface-service-information-dark);
    --text-on-color-light: var(--color-grayscale-white);
  }
  .bds-hero--with-pricing-card:is([data-audience='product'], [data-service-line='product']) {
    background: var(--surface-service-product-inverse);
    --bds-hero-headline-color: var(--text-service-product-on-light);
    --bds-hero-eyebrow-color: var(--text-service-product-on-light);
    --bds-hero-lead-color: var(--text-service-product-on-light);
    --text-brand-primary: var(--text-service-product-on-light);
    --background-inverse: var(--surface-service-product-dark);
    --text-on-color-light: var(--color-grayscale-white);
  }
  .bds-hero--with-pricing-card:is([data-audience='back-office'], [data-service-line='back-office']),
  .bds-hero--with-pricing-card:is([data-audience='service'], [data-service-line='service']) {
    background: var(--surface-service-back-office-inverse);
    --bds-hero-headline-color: var(--text-service-back-office-on-light);
    --bds-hero-eyebrow-color: var(--text-service-back-office-on-light);
    --bds-hero-lead-color: var(--text-service-back-office-on-light);
    --text-brand-primary: var(--text-service-back-office-on-light);
    --background-inverse: var(--surface-service-back-office-dark);
    --text-on-color-light: var(--color-grayscale-white);
  }

  /* ── Dark-mode: --text-inverse must track the softened service-dark surface.
   * surface-service-{hue}-dark softens one tier in dark mode (darkest → darker,
   * per ADR-011). Lighter darker-step surfaces (brand yellow, marketing green)
   * can't sustain white text (2.87–4.36:1); darker ones can. Override
   * --text-inverse per luminance group so all five lines pass AA in dark mode.
   * Uses mode-invariant --text-on-color-light (black) / --text-on-color-dark (white). */
  :root[data-theme="dark"] .bds-hero--with-pricing-card:is([data-audience='brand'], [data-service-line='brand']),
  :root[data-theme="dark"] .bds-hero--with-pricing-card:is([data-audience='marketing'], [data-service-line='marketing']) {
    --text-inverse: var(--text-on-color-light); /* black on yellow/green-darker: 4.82–7.33:1 */
  }
  :root[data-theme="dark"] .bds-hero--with-pricing-card:is([data-audience='information'], [data-service-line='information']),
  :root[data-theme="dark"] .bds-hero--with-pricing-card:is([data-audience='product'], [data-service-line='product']),
  :root[data-theme="dark"] .bds-hero--with-pricing-card:is([data-audience='back-office'], [data-service-line='back-office']),
  :root[data-theme="dark"] .bds-hero--with-pricing-card:is([data-audience='service'], [data-service-line='service']) {
    --text-inverse: var(--text-on-color-dark);  /* white on blue/purple/orange-darker: 5.48–9.48:1 */
  }

  /* ── Dark-mode: the inverse surface flips white → {hue}-darkest, so the card's
   * own headline/eyebrow/lead (and the breadcrumb/link --text-brand-primary that
   * cascade on the same surface) must flip from --text-service-{line}-on-light
   * ({hue}-darkest — invisible on the dark surface) to the light-on-dark
   * companion --text-service-{line}-on-dark ({hue}-lighter). AA-verified per line
   * (6.89–9.06:1) via contrast-gate (brik-bds#1017). The inner inverse <Button>
   * is unaffected: its label/fill ride --text-inverse / --background-inverse
   * (surface-service-{line}-dark), handled above. */
  :root[data-theme="dark"] .bds-hero--with-pricing-card:is([data-audience='brand'], [data-service-line='brand']) {
