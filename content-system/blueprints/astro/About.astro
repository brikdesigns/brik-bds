---
/**
 * About — canonical `bds-about` narrative block for the Astro rail.
 * Twin of the React `<About>` primitive (brik-bds#1198). Renamed from
 * `AboutStorySplit.astro` in #2302: the file is the block, and `about` is a
 * single-member family, so there is no layout modifier and no layout prop
 * (ADR-008 §3). The former `bp-about-story-split` class was already retired
 * for the structural `bds-about` block. Label + heading + narrative, with an
 * optional pull-quote.
 *
 * `blueprintKey` is supplied by `BlueprintDispatcher.astro` and rendered as
 * `data-blueprint-key`; composing this block directly emits no key marker.
 *
 * The pull-quote is a blueprint-owned `bds-about__callout` figure styled to
 * mirror the React path's outlined `<CardTestimonial>`. Astro has no
 * CardTestimonial twin, and the blueprint naming gate forbids a blueprint
 * carrying a component's internal `__body` slot — so the Astro path
 * reproduces the outlined-card look under the single published
 * `bds-about__callout` slot, styling its children with element selectors
 * (the self-contained-scoped-style pattern every Astro blueprint uses).
 * React and Astro reach visual parity via separate code, as the family
 * always has.
 *
 * Contract: BlueprintProps.
 *   - section.heading    — section heading (h2)
 *   - section.subheading — eyebrow (optional)
 *   - section.body       — the narrative (REQUIRED by content gen)
 *   - section.items[0]   — optional pull-quote:
 *                            item.title = attribution (role/name)
 *                            item.description = the quote
 *
 * required_facts: []. Section-driven.
 *
 * CSS custom properties (Tier-4 hooks):
 *   --bds-about-bg              (default: var(--bds-page-primary))
 *   --bds-about-heading-color   (default: var(--bds-text-primary))
 *   --bds-about-body-color      (default: var(--bds-text-secondary))
 *   --bds-about-eyebrow-color   (default: var(--bds-text-brand-primary))
 *
 * a11y: h2 + aria-labelledby. Pull-quote uses semantic blockquote + cite.
 * Reading order: narrative first (left column), supporting callout second
 * (right) — matches DOM order on every viewport.
 */
import type { BlueprintAlign, BlueprintProps, KnownBlueprintKey } from './types';

// Shared section shell (ADR-021) — global, unscoped; Astro dedupes it.
import '../section-shell.css';

interface Props extends BlueprintProps {
  /**
   * Blueprint key to emit as `data-blueprint-key`. Supplied by
   * `BlueprintDispatcher.astro`; omitted when the block is composed directly.
   */
  blueprintKey?: KnownBlueprintKey;
  /**
   * Narrative-column placement (structure axis, ADR-039). `left` (default) or
   * `center`; emits `bds-about--align-center`. Matches the React twin.
   */
  align?: BlueprintAlign;
}

const { section, blueprintKey, align = 'left' } = Astro.props;
const titleId = `${section.sectionKey}-title`;
const callout = section.items[0];
---

<section
  class={`bds-blueprint-section bds-about${align === 'center' ? ' bds-about--align-center' : ''}`}
  aria-labelledby={titleId}
  data-blueprint-key={blueprintKey}
>
  <div class="bds-blueprint-section__container bds-about__container">
    <div class="bds-about__narrative">
      {section.subheading && (
        <p class="bds-about__subtitle">{section.subheading}</p>
      )}
      <h2 id={titleId} class="bds-about__title">{section.heading}</h2>
      {section.body && (
        <p class="bds-about__lead">{section.body}</p>
      )}
    </div>

    {callout && (
      <figure class="bds-about__callout">
        <blockquote>{callout.description}</blockquote>
        <figcaption>
          <cite>{callout.title}</cite>
        </figcaption>
      </figure>
    )}
  </div>
</section>

<style>
  /* Section rhythm + centred container: ../section-shell.css (ADR-021). */
  .bds-about {
    background: var(--bds-about-bg, var(--bds-page-primary));
  }

  .bds-about__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--bds-gap-xl);
  }

  @media (min-width: 768px) {
    .bds-about__container:has(.bds-about__callout) {
      grid-template-columns: 3fr 2fr;
      gap: var(--bds-gap-huge);
      align-items: start;
    }
  }

  .bds-about__narrative {
    display: flex;
    flex-direction: column;
  }

  /* ── --align-center: structure axis (ADR-039 §1) ──────────────
     Mirrors ../react/About.css. Centres the narrative column; `left` is the
     default and emits no modifier. */
  .bds-about--align-center .bds-about__narrative {
    align-items: center;
    text-align: center;
  }

  /* Content rhythm (ADR-023 §3), mirroring the React twin in About.css:
     eyebrow→title is tight (--bds-gap-sm), title→lead is medium (--bds-gap-md). */

  .bds-about__narrative > * + * {
    margin-top: var(--bds-gap-md);
  }

  .bds-about__subtitle + .bds-about__title {
    margin-top: var(--bds-gap-sm);
  }

  .bds-about__subtitle {
    margin: 0;
    font-family: var(--bds-font-family-label);
    font-size: var(--bds-label-lg);
    font-weight: var(--bds-font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bds-about-eyebrow-color, var(--bds-text-brand-primary));
  }

  .bds-about__title {
    margin: 0;
    font-family: var(--bds-font-family-heading);
    font-size: clamp(var(--bds-heading-lg), 3.5vw, var(--bds-heading-xl));
    font-weight: var(--bds-font-weight-semibold);
    line-height: var(--bds-font-line-height-tight);
    color: var(--bds-about-heading-color, var(--bds-text-primary));
  }

  .bds-about__lead {
    margin: 0;
    font-family: var(--bds-font-family-body);
    font-size: var(--bds-heading-sm);
    line-height: var(--bds-font-line-height-relaxed);
    color: var(--bds-about-body-color, var(--bds-text-secondary));
    max-width: 65ch;
  }

  /* Pull-quote — mirrors the React path's outlined <CardTestimonial>
     (components/ui/CardTestimonial), kept in visual sync via shared tokens.
     Astro has no CardTestimonial twin, and the blueprint gates forbid both a
     component's internal `__body` slot (banned-suffix) and Astro-only `bds-*`
     slots absent from the published allowlist (canonical-class-check). So the
     only bds- class is the published `__callout`; its children are styled by
     element selectors, and the quote mark is a decorative `::before`. */
  .bds-about__callout {
    display: flex;
    flex-direction: column;
    gap: var(--bds-gap-lg);
    margin: 0;
    padding: var(--bds-padding-lg);
    border-radius: var(--bds-border-radius-md);
    background-color: var(--bds-surface-primary);
    border: var(--bds-border-width-md) solid var(--bds-border-secondary);
  }

  .bds-about__callout::before {
    content: '“';
    font-family: var(--bds-font-family-display);
    font-size: var(--bds-heading-huge);
    font-weight: var(--bds-font-weight-bold);
    line-height: var(--bds-font-line-height-tight);
    color: var(--bds-text-brand-primary);
    user-select: none;
  }

  .bds-about__callout blockquote {
    margin: 0;
    font-family: var(--bds-font-family-body);
    font-size: var(--bds-body-md);
    font-weight: var(--bds-font-weight-regular);
    line-height: var(--bds-font-line-height-normal);
    color: var(--bds-text-primary);
  }

  .bds-about__callout figcaption {
    display: flex;
    flex-direction: column;
    /* Tight text pairing: --bds-gap-sm. Not --bds-gap-xs, which resolves to 0px
       outside default spacing mode (ADR-023 §3). */
    gap: var(--bds-gap-sm);
  }

  .bds-about__callout cite {
    margin: 0;
    font-family: var(--bds-font-family-label);
    font-size: var(--bds-label-md);
    font-weight: var(--bds-font-weight-semibold);
    line-height: var(--bds-font-line-height-snug);
    font-style: normal;
    color: var(--bds-text-primary);
  }
</style>
