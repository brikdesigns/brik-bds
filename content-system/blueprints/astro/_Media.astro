---
/**
 * _Media — the shared media primitive for the blueprint media axis
 * (ADR-039 §Media axis, brik-bds#2493). Astro twin of `../react/BlockMedia.tsx`;
 * emits the same `bds-block-media*` / `bds-frame*` classes (order differs — the
 * React rail composes them through `<Frame>` — but class-attribute order carries
 * no specificity), so both rails render the same media. Underscore-prefixed: a
 * presentational partial composed
 * by blocks (e.g. `Hero.astro`'s `split` layout), not a dispatched blueprint.
 *
 * A blueprint never hand-rolls `<video>` markup, an `aspect-ratio`, or an
 * autoplay attribute — it selects a `media` value and this partial renders the
 * matching element wrapped in a `<Frame>` (the token-backed `bds-frame--ratio-*`
 * box, so no `aspect-ratio` is written in blueprint CSS).
 *
 * No `<style>` block: the `bds-block-media*` classes are single-sourced in
 * `../react/BlockMedia.css` (→ `dist/styles.css`), which the consumer site's BDS
 * stylesheet ships and the Storybook shell imports via `_AstroFrame.tsx`
 * (ADR-040 mirror coverage) — the same self-contained pattern as
 * `HeroMediaCardImage.astro`.
 *
 * **`bg-video` reduced-motion gate (AC3).** The `<video>` carries NO static
 * `autoplay` attribute, so with JS off — or under `prefers-reduced-motion` — it
 * rests on its `poster` and never animates (the safe default, matching
 * AmbientField's "still state applies even if JS never arrives"). The inline
 * guard below enables autoplay only when motion is allowed. `preload="none"`
 * keeps it lazy. This is the by-construction gate: a consumer cannot ship
 * un-gated ambient motion through this axis.
 *
 * @summary Blueprint media partial — a `Frame`-wrapped `img`/`video` selected by the `media` axis, with reduced-motion-gated `bg-video`.
 */
import type { BlueprintMedia } from './types';

/**
 * Aspect-ratio slug — mirrors the BDS `FrameRatio` vocabulary backed by the
 * `--aspect-*` token family (#486). Duplicated locally rather than imported from
 * the React `Frame` component so this shipped partial stays self-contained for
 * consumer Astro builds (matches `HeroMediaCardImage.astro`'s rationale).
 */
type FrameRatio =
  | '1-1' | '3-2' | '2-3' | '4-3' | '3-4' | '4-5' | '16-9' | '9-16' | '21-9'
  | 'square' | 'photo-landscape' | 'photo-portrait' | 'cinema'
  /** @deprecated Use `3-4`. */ | 'portrait'
  /** @deprecated Use `4-3`. */ | 'landscape'
  /** @deprecated Use `16-9` or `cinema`. */ | 'wide'
  /** @deprecated Use `21-9`. */ | 'ultrawide';

type FrameFit = 'cover' | 'contain' | 'fill' | 'none';

interface Props {
  /** Which media the block carries. See `BlueprintMedia`. */
  media: BlueprintMedia;
  /** Media source — image for `image`, video for `video` / `bg-video`. */
  src?: string | null;
  /** Poster still for `video` / `bg-video`. Ignored for `image`. */
  poster?: string | null;
  /** Alt text for `image`. Defaults to empty (decorative). */
  alt?: string;
  /** `Frame` aspect ratio. Default `16-9` (video-native). */
  ratio?: FrameRatio;
  /** How the media fits the frame. Default `cover`. */
  fit?: FrameFit;
  /**
   * `<img>` loading hint for `image`. Default `lazy`; pass `eager` for
   * above-the-fold / LCP media (e.g. the hero image). Ignored for video.
   */
  loading?: 'eager' | 'lazy';
  /** Extra classes appended after the canonical `bds-block-media` classes. */
  class?: string;
}

const { media, src, poster, alt = '', ratio = '16-9', fit = 'cover', loading = 'lazy', class: className } = Astro.props;

const frameClass = ['bds-frame', `bds-frame--ratio-${ratio}`, `bds-frame--fit-${fit}`].join(' ');
// Only `bg-video` carries a modifier class (it needs its own CSS); `image` /
// `video` differ by element, not styling, so a rule-less `--image` / `--video`
// modifier would be an invented class (`canonical-class-check`). Mirrors
// ../react/BlockMedia.tsx.
const rootClass = (variant: BlueprintMedia) =>
  ['bds-block-media', variant === 'bg-video' && 'bds-block-media--bg-video', frameClass, className]
    .filter(Boolean)
    .join(' ');

const render = media !== 'none' && !!src;
const isBgVideo = media === 'bg-video';
---

{render && (media === 'image' ? (
  <div class={rootClass('image')}>
    <img class="bds-block-media__img" src={src} alt={alt} loading={loading} decoding="async" />
  </div>
) : isBgVideo ? (
  <div class={rootClass('bg-video')}>
    <video
      class="bds-block-media__video"
      src={src}
      poster={poster ?? undefined}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-bds-bg-video
    ></video>
  </div>
) : (
  <div class={rootClass('video')}>
    <video
      class="bds-block-media__video"
      src={src}
      poster={poster ?? undefined}
      controls
      playsinline
      preload="metadata"
    ></video>
  </div>
))}

{render && isBgVideo && (
  <script is:inline>
    {`(function () {
      if (window.__bdsBgVideoInit) return;
      window.__bdsBgVideoInit = true;
      var mq = window.matchMedia('(prefers-reduced-motion: reduce)');
      function sync() {
        document.querySelectorAll('video[data-bds-bg-video]').forEach(function (v) {
          if (mq.matches) {
            v.removeAttribute('autoplay');
            if (!v.paused && v.pause) v.pause();
          } else {
            v.setAttribute('autoplay', '');
            if (v.paused && v.play) {
              var p = v.play();
              if (p && p.catch) p.catch(function (err) { console.debug('[bds-bg-video] play() rejected:', err); });
            }
          }
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', sync, { once: true });
      } else {
        sync();
      }
      mq.addEventListener('change', sync);
    })();`}
  </script>
)}
